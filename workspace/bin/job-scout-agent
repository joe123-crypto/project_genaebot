#!/usr/bin/env bash
set -euo pipefail

scope=""
phone=""
mode=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --phone) phone="${2:-}"; scope="phone"; shift 2 ;;
    --all) scope="all"; shift ;;
    --preview) mode="preview"; shift ;;
    --live) mode="live"; shift ;;
    *) printf 'usage: %s (--phone E164|--all) (--preview|--live)\n' "$0" >&2; exit 2 ;;
  esac
done
[ -n "$scope" ] && [ -n "$mode" ] || { printf 'scope and mode are required\n' >&2; exit 2; }
if [ "$scope" = "phone" ]; then
  phone="+$(printf '%s' "$phone" | tr -cd '0-9')"
  [[ "$phone" =~ ^\+[0-9]{9,16}$ ]] || { printf 'phone must be an E.164 number\n' >&2; exit 2; }
fi
if [ "$scope" = "all" ] && [ "$mode" != "preview" ]; then
  printf -- '--all is allowed only with --preview\n' >&2
  exit 2
fi

job_scout=(/home/joseph/.openclaw/workspace/bin/job-scout)
run_id="manual-job-scout-$(date -u +%Y%m%dT%H%M%SZ)"
prepare_args=(dispatch-jsearch --agent-phase prepare --run-id "$run_id" --limit-ready 100 --shortlist-limit 20 --match-threshold 70)
[ "$scope" = "phone" ] && prepare_args+=(--phone "$phone")
[ "$mode" = "preview" ] && prepare_args+=(--dry-run)

if [ "$scope" = "phone" ]; then
  "${job_scout[@]}" status --phone "$phone" >/dev/null
fi

# Preparation can be quiet for several minutes while source requests finish.
# Keep it outside the model turn so an agent-chosen exec timeout cannot kill it
# or waste source credits by starting it again. If an unfinished run is being
# resumed, its canonical runId replaces the newly requested one here.
prepare_json="$("${job_scout[@]}" "${prepare_args[@]}")"
run_id="$(printf '%s' "$prepare_json" | python3 -c '
import json
import sys

result = json.load(sys.stdin)
run_id = result.get("runId")
if result.get("ok") is not True or result.get("agentPhase") != "prepare" or not isinstance(run_id, str) or not run_id:
  raise SystemExit("Job Scout preparation returned an invalid result")
print(run_id)
')"
read -r -d '' prompt <<EOF || true
Run one operator-authorized Job Scout ${mode} dispatch.

Follow the Daily OpenClaw Agent Dispatch parent and child protocol in /home/joseph/.openclaw/workspace/skills/job-scout/SKILL.md exactly, with these overrides:
- The trusted wrapper has already completed preparation for runId ${run_id}. Do not run the prepare phase.
- Start by running the status phase for runId ${run_id}; use its opaque pending or claimed claims.
- Spawn isolated main children as documented, no more than four at once. Use simple lowercase task names such as job_scout_1; never derive a task name from a claim ID.
- If a child fails or its claim does not complete, invoke that claim's --agent-phase fallback exactly once. This records failure and must not submit template documents.
- Finish only after terminalCount equals claimCount.
- Never invoke direct dispatch-jsearch mode and never retry a failed child.
EOF

env -u OPENCLAW_HOME OPENCLAW_GATEWAY_TOKEN="${GATEWAY_AUTH_TOKEN:?missing gateway token}" \
  openclaw agent --agent main --session-key "agent:main:job-scout-manual:$run_id" \
  --message "$prompt" --timeout 21600 --json

# A parent turn intentionally returns after sessions_yield; completion events
# resume it asynchronously. Keep the operator process attached to durable state
# until finish makes the dispatch verifiable.
deadline=$((SECONDS + 21600))
until "${job_scout[@]}" verify-dispatch --run-id "$run_id" >/dev/null 2>&1; do
  if [ "$SECONDS" -ge "$deadline" ]; then
    printf 'Job Scout agent dispatch did not finish within 21600 seconds\n' >&2
    exit 1
  fi
  sleep 10
done
