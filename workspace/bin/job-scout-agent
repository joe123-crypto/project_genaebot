#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd -- "$script_dir/.." && pwd -P)"
# The Python package sits directly under repo_root in a standalone checkout and
# under repo_root/job-scout in the deployed workspace overlay. Resolve it the
# same way the job-scout and job-scout-channel-health wrappers do so the
# model-auth preflight can import jobscout in either layout.
source_root="${JOB_SCOUT_SOURCE_ROOT:-}"
if [ -z "$source_root" ]; then
  if [ -f "$repo_root/jobscout/model_auth.py" ]; then
    source_root="$repo_root"
  elif [ -f "$repo_root/job-scout/jobscout/model_auth.py" ]; then
    source_root="$repo_root/job-scout"
  else
    source_root="$repo_root"
  fi
fi
job_scout_bin="${JOB_SCOUT_BIN:-$script_dir/job-scout}"
[ -x "$job_scout_bin" ] || {
  printf 'Job Scout command is not executable: %s\n' "$job_scout_bin" >&2
  exit 1
}

if [ -n "${OPENCLAW_BIN:-}" ]; then
  openclaw_bin="$OPENCLAW_BIN"
elif command -v openclaw >/dev/null 2>&1; then
  openclaw_bin="$(command -v openclaw)"
elif [ -x /usr/local/bin/openclaw ]; then
  openclaw_bin=/usr/local/bin/openclaw
elif [ -x /home/joseph/.npm-global/bin/openclaw ]; then
  openclaw_bin=/home/joseph/.npm-global/bin/openclaw
else
  openclaw_bin=openclaw
fi

scope=""
phone=""
user_id=""
mode=""
daily_live=false
approved_live=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    --phone)
      [ -z "$scope" ] || { printf 'only one scope may be specified\n' >&2; exit 2; }
      phone="${2:-}"; scope="phone"; shift 2
      ;;
    --user-id)
      [ -z "$scope" ] || { printf 'only one scope may be specified\n' >&2; exit 2; }
      user_id="${2:-}"; scope="user"; shift 2
      ;;
    --all)
      [ -z "$scope" ] || { printf 'only one scope may be specified\n' >&2; exit 2; }
      scope="all"; shift
      ;;
    --preview) mode="preview"; shift ;;
    --live) mode="live"; shift ;;
    --daily-live)
      [ -z "$scope" ] && [ -z "$mode" ] && [ "$#" -eq 1 ] || {
        printf -- '--daily-live cannot be combined with another scope or mode\n' >&2
        exit 2
      }
      daily_live=true; scope="daily"; mode="live"; shift
      ;;
    --approved-live)
      [ -z "$scope" ] && [ -z "$mode" ] && [ "$#" -eq 1 ] || {
        printf -- '--approved-live cannot be combined with another scope or mode\n' >&2
        exit 2
      }
      approved_live=true; scope="approved"; mode="live"; shift
      ;;
    *) printf 'usage: %s ((--phone E164|--user-id UID|--all) (--preview|--live)|--daily-live|--approved-live)\n' "$0" >&2; exit 2 ;;
  esac
done
[ -n "$scope" ] && [ -n "$mode" ] || { printf 'scope and mode are required\n' >&2; exit 2; }
if [ "$daily_live" = true ] && { [ "$scope" != "daily" ] || [ "$mode" != "live" ]; }; then
  printf -- '--daily-live cannot be combined with another scope or mode\n' >&2
  exit 2
fi
if [ "$approved_live" = true ] && { [ "$scope" != "approved" ] || [ "$mode" != "live" ]; }; then
  printf -- '--approved-live cannot be combined with another scope or mode\n' >&2
  exit 2
fi
if [ "$scope" = "phone" ]; then
  phone="+$(printf '%s' "$phone" | tr -cd '0-9')"
  [[ "$phone" =~ ^\+[0-9]{9,16}$ ]] || { printf 'phone must be an E.164 number\n' >&2; exit 2; }
fi
if [ "$scope" = "user" ]; then
  [[ "$user_id" =~ ^[A-Za-z0-9_-]{1,128}$ ]] || { printf 'user-id is invalid\n' >&2; exit 2; }
fi
if [ "$scope" = "all" ] && [ "$mode" != "preview" ]; then
  printf -- '--all is allowed only with --preview\n' >&2
  exit 2
fi

job_scout=("$job_scout_bin")
if [ "$scope" = "approved" ]; then
  approved_json="$("${job_scout[@]}" count-approved-applications --limit 100)"
  approved_count="$(printf '%s' "$approved_json" | python3 -c '
import json
import sys
value = json.load(sys.stdin).get("approvedCount")
if not isinstance(value, int):
  raise SystemExit("Job Scout approval count returned an invalid result")
print(value)
')"
  [ "$approved_count" -gt 0 ] || exit 0
fi
run_prefix="manual-job-scout"
[ "$scope" = "daily" ] && run_prefix="daily-job-scout"
[ "$scope" = "approved" ] && run_prefix="approved-job-scout"
run_id="${run_prefix}-$(date -u +%Y%m%dT%H%M%SZ)"
prepare_args=(dispatch-jsearch --agent-phase prepare --run-id "$run_id" --limit-ready 100 --shortlist-limit 20 --match-threshold 51)
[ "$scope" = "phone" ] && prepare_args+=(--phone "$phone")
[ "$scope" = "user" ] && prepare_args+=(--user-id "$user_id")
[ "$mode" = "preview" ] && prepare_args+=(--dry-run)
[ "$scope" = "daily" ] && prepare_args+=(--write-group-feed-cache)
[ "$scope" = "approved" ] && prepare_args+=(--approved-only --browser-apply)

if [ "$scope" = "phone" ]; then
  "${job_scout[@]}" status --phone "$phone" >/dev/null
fi

# Preparation can be quiet for several minutes while source requests finish.
# Keep it outside the model turn so an agent-chosen exec timeout cannot kill it
# or waste source credits by starting it again. If an unfinished run is being
# resumed, its canonical runId replaces the newly requested one here.
prepare_json="$("${job_scout[@]}" "${prepare_args[@]}")"
read -r run_id claim_count busy < <(printf '%s' "$prepare_json" | python3 -c '
import json
import sys

result = json.load(sys.stdin)
run_id = result.get("runId")
claim_count = result.get("claimCount")
busy = result.get("busy") is True
if result.get("ok") is not True or result.get("agentPhase") != "prepare" or not isinstance(run_id, str) or not run_id or not isinstance(claim_count, int):
  raise SystemExit("Job Scout preparation returned an invalid result")
print(run_id, claim_count, "true" if busy else "false")
')
if [ "$busy" = true ]; then
  [ "$scope" = "approved" ] && exit 0
  printf 'another Job Scout dispatch mode is already active\n' >&2
  exit 1
fi
if [ "$claim_count" -eq 0 ]; then
  "${job_scout[@]}" dispatch-jsearch --agent-phase finish --run-id "$run_id" >/dev/null
  "${job_scout[@]}" verify-dispatch --run-id "$run_id" --require-no-failures >/dev/null
  exit 0
fi
job_scout_skill="${JOB_SCOUT_SKILL_PATH:-}"
if [ -z "$job_scout_skill" ]; then
  if [ -f "$repo_root/skill/SKILL.md" ]; then
    job_scout_skill="$repo_root/skill/SKILL.md"
  elif [ -f "$repo_root/skills/job-scout/SKILL.md" ]; then
    job_scout_skill="$repo_root/skills/job-scout/SKILL.md"
  else
    printf 'unable to locate Job Scout skill; set JOB_SCOUT_SKILL_PATH\n' >&2
    exit 1
  fi
fi
[ -f "$job_scout_skill" ] || {
  printf 'Job Scout skill was not found: %s\n' "$job_scout_skill" >&2
  exit 1
}
read -r -d '' prompt <<EOF || true
Run one operator-authorized Job Scout ${mode} dispatch.

Follow the Daily OpenClaw Agent Dispatch parent and child protocol in ${job_scout_skill} exactly, with these overrides:
- Use ${job_scout_bin} for every Job Scout command in the parent and child tasks, replacing the deployed absolute command path shown in the skill when different.
- The trusted wrapper has already completed preparation for runId ${run_id}. Do not run the prepare phase.
- This run may contain discovery claims, approval-first matching claims, or user-approved submission claims. Follow each claim packet's approvalRequired and approvedSubmission flags exactly.
- Start by running the status phase for runId ${run_id}; use its opaque pending or claimed claims.
- Spawn isolated main children as documented, no more than four at once. Use simple lowercase task names such as job_scout_1; never derive a task name from a claim ID.
- After each batch is spawned, use the durable wait phase exactly as documented. Never call sessions_yield and never depend on child announce delivery.
- If a wait times out, invoke --agent-phase fallback exactly once for each still non-terminal claim in that batch. This records failure and must not submit template documents.
- Finish only after terminalCount equals claimCount.
- Never invoke direct dispatch-jsearch mode and never retry a failed child.
EOF

# A model-auth preflight or agent-turn failure must never leave the run frozen at
# the prepared "ready" phase with the exclusive claim still held: the next daily
# cron would then wait out the multi-hour active-run timeout before recovering, and
# the failure would stay invisible until then. Mark every still non-terminal claim
# failed and finish the marker so the run is durably failed, the active pointer is
# released, and verify-dispatch surfaces the failure the same day.
cleanup_failed_dispatch() {
  local reason="$1"
  local status_json cid
  status_json="$("${job_scout[@]}" dispatch-jsearch --agent-phase status --run-id "$run_id" 2>/dev/null || true)"
  if [ -n "$status_json" ]; then
    while IFS= read -r cid; do
      [ -n "$cid" ] || continue
      "${job_scout[@]}" dispatch-jsearch --agent-phase fallback --run-id "$run_id" \
        --claim-id "$cid" --fallback-reason "$reason" >/dev/null 2>&1 || true
    done < <(printf '%s' "$status_json" | python3 -c '
import json
import sys

try:
  data = json.load(sys.stdin)
except (ValueError, TypeError):
  raise SystemExit(0)
terminal = {"completed", "failed", "fallback_completed"}
for claim in data.get("claims", []):
  if claim.get("status") not in terminal:
    cid = claim.get("claimId")
    if isinstance(cid, str) and cid:
      print(cid)
')
  fi
  "${job_scout[@]}" dispatch-jsearch --agent-phase finish --run-id "$run_id" >/dev/null 2>&1 || true
}

if ! env -u OPENCLAW_HOME OPENCLAW_GATEWAY_TOKEN="${GATEWAY_AUTH_TOKEN:?missing gateway token}" \
  PYTHONPATH="$source_root${PYTHONPATH:+:$PYTHONPATH}" python3 -m jobscout.model_auth --agent main; then
  cleanup_failed_dispatch "Job Scout model auth preflight failed"
  printf 'Job Scout model auth preflight failed for runId %s; dispatch marked failed\n' "$run_id" >&2
  exit 1
fi

if ! env -u OPENCLAW_HOME OPENCLAW_GATEWAY_TOKEN="${GATEWAY_AUTH_TOKEN:?missing gateway token}" \
  "$openclaw_bin" agent --agent main --session-key "agent:main:job-scout-manual:$run_id" \
  --message "$prompt" --timeout 21600 --json; then
  cleanup_failed_dispatch "OpenClaw main agent dispatch turn failed"
  printf 'OpenClaw Job Scout dispatch turn failed for runId %s; dispatch marked failed\n' "$run_id" >&2
  exit 1
fi

# A zero exit from the model turn is not sufficient. The command cron succeeds
# only when durable finish has made the dispatch marker verifiable.
"${job_scout[@]}" verify-dispatch --run-id "$run_id" --require-no-failures >/dev/null
