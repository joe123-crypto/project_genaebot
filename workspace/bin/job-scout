#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd -- "$script_dir/.." && pwd -P)"
source_root="${JOB_SCOUT_SOURCE_ROOT:-}"
if [ -z "$source_root" ]; then
  if [ -f "$repo_root/job_scout.py" ]; then
    source_root="$repo_root"
  elif [ -f "$repo_root/job-scout/job_scout.py" ]; then
    source_root="$repo_root/job-scout"
  else
    printf 'unable to locate job_scout.py; set JOB_SCOUT_SOURCE_ROOT\n' >&2
    exit 1
  fi
fi
[ -f "$source_root/job_scout.py" ] || {
  printf 'job_scout.py was not found under JOB_SCOUT_SOURCE_ROOT=%s\n' "$source_root" >&2
  exit 1
}

openclaw_home="${OPENCLAW_HOME:-${HOME:?HOME must be set}/.openclaw}"
export OPENCLAW_PENDING_LINKS_PATH="${OPENCLAW_PENDING_LINKS_PATH:-$openclaw_home/runtime/account-link/pending-links.json}"
mkdir -p "$(dirname "$OPENCLAW_PENDING_LINKS_PATH")"
exec python3 "$source_root/job_scout.py" "$@"
