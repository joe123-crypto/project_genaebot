#!/usr/bin/env python3
"""Generate the seven promo targets.json files from workspace/cron/membership.json.

membership.json is the single source of truth for which groups the bot
advertises in; each promo's targets.json is derived from it. Only groups with
status "active" reach a targets file, so an admin-only, not-a-member or on-hold
group is excluded by its status rather than by prose in a comment.

Usage:
  make-promo-targets            check for drift (default; writes nothing)
  make-promo-targets --check    same, explicitly
  make-promo-targets --write    rewrite the targets files from membership.json
  make-promo-targets --json     machine-readable drift report (implies --check)

Exit status is 0 when the committed files already match membership.json and 1
when they drift (or membership.json is invalid), which is what
deploy/test_promo_targets_generated.py asserts in CI.

Std-lib only.
"""

import os
import sys
import json
import difflib
from pathlib import Path

WORKSPACE = Path(__file__).resolve().parents[1]
LIB_DIR = str(WORKSPACE / "lib")
if LIB_DIR not in sys.path:
    sys.path.insert(0, LIB_DIR)

import promo_membership  # noqa: E402

CRON_DIR = str(WORKSPACE / "cron")


def rel(path):
    try:
        return os.path.relpath(path, WORKSPACE.parent)
    except ValueError:
        return path


def render(m):
    """``{path: expected text}`` for every promo declared in membership.json."""
    out = {}
    for promo in sorted((m.get("promos") or {})):
        path = promo_membership.targets_path(m, promo, CRON_DIR)
        payload = promo_membership.targets_payload(m, promo)
        out[path] = promo_membership.dumps_targets(payload)
    return out


def main(argv):
    args = argv[1:]
    unknown = [a for a in args if a not in ("--check", "--write", "--json")]
    if unknown:
        sys.stderr.write("unknown argument(s): %s\n\n%s" % (" ".join(unknown), __doc__))
        return 2
    write = "--write" in args
    as_json = "--json" in args

    membership_path = promo_membership.default_path(str(WORKSPACE))
    try:
        m = promo_membership.load(membership_path)
    except ValueError as ex:
        sys.stderr.write("ERROR: %s\n" % ex)
        return 1
    if m is None:
        sys.stderr.write("ERROR: membership file not found: %s\n" % membership_path)
        return 1

    errors = promo_membership.validate(m)
    if errors:
        sys.stderr.write("ERROR: %s is invalid:\n" % rel(membership_path))
        for e in errors:
            sys.stderr.write("  - %s\n" % e)
        return 1

    expected = render(m)
    drifted = []
    for path, text in sorted(expected.items()):
        try:
            with open(path, encoding="utf-8") as f:
                current = f.read()
        except (FileNotFoundError, OSError):
            current = None
        if current == text:
            continue
        drifted.append((path, current, text))

    if as_json:
        print(json.dumps({
            "membership": rel(membership_path),
            "checked": [rel(p) for p in sorted(expected)],
            "drifted": [rel(p) for p, _, _ in drifted],
        }, indent=2))

    if write:
        for path, _, text in drifted:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            tmp = path + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                f.write(text)
            os.replace(tmp, path)
            print("wrote %s" % rel(path))
        if not drifted:
            print("already up to date (%d targets files)" % len(expected))
        return 0

    if not drifted:
        if not as_json:
            print("up to date: %d targets files match %s"
                  % (len(expected), rel(membership_path)))
        return 0

    if not as_json:
        for path, current, text in drifted:
            sys.stderr.write("\n%s differs from membership.json:\n" % rel(path))
            diff = difflib.unified_diff(
                (current or "").splitlines(keepends=True),
                text.splitlines(keepends=True),
                fromfile=rel(path) + " (committed)",
                tofile=rel(path) + " (from membership.json)",
            )
            sys.stderr.writelines(diff)
        sys.stderr.write(
            "\n%d of %d targets files drifted. Run "
            "workspace/bin/make-promo-targets --write and commit the result.\n"
            % (len(drifted), len(expected)))
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
