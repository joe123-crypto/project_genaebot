#!/usr/bin/env python3
"""Print one public campaign lookup. Invoked only by the trusted plugin."""
import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import public_campaigns

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--query", default="")
parser.add_argument("--campaign-id", default="")
parser.add_argument("--discover", action="store_true")
parser.add_argument("--cv-available", action="store_true")
args = parser.parse_args()
print(json.dumps(public_campaigns.lookup(query=args.query, campaign_id=args.campaign_id,
                                        discover=args.discover, cv_available=args.cv_available)))
