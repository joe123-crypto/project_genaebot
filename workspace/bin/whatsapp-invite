#!/usr/bin/env bash
# Wrapper for the WhatsApp peer-invite store CLI. The store is runtime database
# state; override with OPENCLAW_INVITES_PATH for migrations or tests.
export OPENCLAW_INVITES_PATH="${OPENCLAW_INVITES_PATH:-/home/joseph/.openclaw/runtime/public-service-gate/invites.json}"
mkdir -p "$(dirname "$OPENCLAW_INVITES_PATH")"
exec python3 /home/joseph/.openclaw/workspace/lib/whatsapp-invite.py "$@"
