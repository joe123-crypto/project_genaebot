#!/usr/bin/env python3
"""Print every known WhatsApp group with its name, today's ad cap and the promos
that target it.

Read-only: reads the operator config a campaign run would act on -- the repo's
membership.json, or Firestore once GENAIE_CONFIG_SOURCE says so (see
promo_config) -- and, when it is readable, the ad-reply counters the caps are
derived from. The header names which store the rows came from. It never contacts
the gateway and never writes anything, so it is safe to run locally or on the
gateway.

Usage:
  list-groups            table
  list-groups --json     one JSON object per group
  list-groups --caps     show today's cap, tier, reply score and which promos
                         today's rotation gives the allowance to
  list-groups --date YYYY-MM-DD   evaluate the caps for another day

Std-lib only.
"""

import os
import sys
import json
from datetime import date
from pathlib import Path

WORKSPACE = Path(__file__).resolve().parents[1]
LIB_DIR = str(WORKSPACE / "lib")
if LIB_DIR not in sys.path:
    sys.path.insert(0, LIB_DIR)

import promo_membership  # noqa: E402
import promo_caps  # noqa: E402
import promo_config  # noqa: E402
import operator_config  # noqa: E402

MEMBERSHIP = promo_membership.default_path(str(WORKSPACE))


def source_label(config):
    """What to print as the origin of these rows. After the cutover the file in
    the repo is not what production reads, so naming it would mislead."""
    if config["source"] == promo_config.FILE:
        return os.path.relpath(MEMBERSHIP, WORKSPACE.parent)
    if config["source"] == "snapshot":
        return "Firestore (last-known-good snapshot: Firestore was unreadable)"
    return "Firestore"


def parse_args(argv):
    opts = {"json": "--json" in argv, "caps": "--caps" in argv, "day": date.today()}
    if "--date" in argv:
        raw = argv[argv.index("--date") + 1] if len(argv) > argv.index("--date") + 1 else ""
        try:
            opts["day"] = date(*(int(p) for p in raw.split("-")))
        except (TypeError, ValueError):
            sys.stderr.write("ERROR: --date wants YYYY-MM-DD, got %r\n" % raw)
            return None
        opts["caps"] = True
    return opts


def rows(m, day, want_caps, disabled=None):
    """One dict per group, in membership order. ``promos`` labels weekly-limited
    promos with their weekdays, as the targets files record them."""
    decisions = {}
    if want_caps:
        # Never records a snapshot: this tool is strictly read-only.
        decisions = promo_caps.plan(m, list(promo_membership.groups(m)), day=day,
                                    record=False, disabled=disabled)
    out = []
    for jid, entry in promo_membership.groups(m).items():
        weekly = entry.get("weekly") or {}
        paused = promo_membership.paused_of(entry)
        labels = []
        for promo in entry.get("promos") or []:
            days = weekly.get(promo)
            label = ("%s (%s only)" % (promo, ", ".join(str(d) for d in days))
                     if days else promo)
            labels.append(label + " [paused]" if promo in paused else label)
        info = decisions.get(jid) or {}
        out.append({
            "jid": jid,
            "name": entry.get("name"),
            "source": entry.get("source"),
            "status": promo_membership.status_of(entry),
            "activity": promo_membership.activity_of(m, entry),
            "daily_cap_override": entry.get("daily_cap"),
            "promos": labels,
            "note": entry.get("note"),
            "cap": info.get("cap"),
            "reply_score": info.get("score"),
            "allowed_today": info.get("allowed"),
        })
    return out


SECTIONS = [
    ("Advertising now", lambda r: r["status"] == "active" and r["promos"]),
    ("Active, in no promo", lambda r: r["status"] == "active" and not r["promos"]),
    ("Not advertised to", lambda r: r["status"] != "active"),
]


def print_table(all_rows, m, day, want_caps, label):
    print("Membership: %s" % label)
    bands = promo_membership.bands(m)
    print("Caps: %s  bands: %s" % (
        "ON" if promo_membership.caps_enabled(m) else "off (caps_enabled is false)",
        ", ".join("%s %d-%d" % (t, lo, hi) for t, (lo, hi) in sorted(bands.items()))))
    if want_caps:
        print("Caps evaluated for %s" % day.isoformat())
    print()
    for title, keep in SECTIONS:
        section = [r for r in all_rows if keep(r)]
        print("%s (%d)" % (title, len(section)))
        for r in section:
            label = r["name"] or "-"
            notes = []
            if r["status"] != "active":
                notes.append(r["status"])
            if r["source"] and r["source"] != "whatsapp":
                notes.append("name from %s" % r["source"])
            if r["daily_cap_override"] is not None:
                notes.append("cap pinned to %s" % r["daily_cap_override"])
            print("  %-50s %-30s %s%s" % (
                label, r["jid"], ", ".join(r["promos"]) or "-",
                ("  [%s]" % "; ".join(notes)) if notes else ""))
            if want_caps and r["status"] == "active" and r["promos"]:
                allowed = r["allowed_today"]
                print("  %-50s %-30s cap %s/day (%d promos)  tier %s  replies %.1f -> %s"
                      % ("", "", r["cap"], len(r["promos"]), r["activity"],
                         r["reply_score"] or 0.0,
                         ", ".join(allowed) if allowed else "nothing"))
        print()
    active = [r for r in all_rows if r["status"] == "active" and r["promos"]]
    sends = sum(len(r["allowed_today"] or []) for r in active) if want_caps else None
    print("Total: %d groups (%d advertised to)" % (len(all_rows), len(active)))
    if want_caps:
        print("Ads scheduled for %s under these caps: %d" % (day.isoformat(), sends))


def main(argv):
    opts = parse_args(argv)
    if opts is None:
        return 2
    # Resolved the same way a campaign run resolves it, so this never shows the
    # file while production acts on Firestore.
    try:
        config = promo_config.resolve(None, membership_path=MEMBERSHIP)
    except operator_config.ConfigUnavailable as ex:
        sys.stderr.write("ERROR: no operator config to read: %s\n" % ex)
        return 1
    except ValueError as ex:
        sys.stderr.write("ERROR: %s\n" % ex)
        return 1
    m = config["membership"]
    if m is None:
        sys.stderr.write("ERROR: membership file not found: %s\n" % MEMBERSHIP)
        return 1
    for e in promo_membership.validate(m):
        sys.stderr.write("WARN: %s: %s\n" % (source_label(config), e))

    want_caps = opts["caps"] or opts["json"]
    all_rows = rows(m, opts["day"], want_caps,
                    disabled={slug for slug, on in config["switches"].items() if not on})
    if opts["json"]:
        for r in all_rows:
            print(json.dumps(r, ensure_ascii=False))
    else:
        print_table(all_rows, m, opts["day"], opts["caps"], source_label(config))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
