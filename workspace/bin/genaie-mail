#!/usr/bin/env python3
"""Send mail through Agent Genaie's Gmail bridge."""

from __future__ import annotations

import argparse
import base64
import json
import mimetypes
import os
from pathlib import Path
import sys
import urllib.error
import urllib.request


LIB_DIR = "/home/joseph/.openclaw/workspace/lib"
if LIB_DIR not in sys.path:
    sys.path.insert(0, LIB_DIR)
from genaie_env import env_default, mail_url


def read_text_arg(value: str | None, file_path: str | None, field: str) -> str | None:
    if value is not None:
        return value
    if file_path is None:
        return None
    path = Path(file_path)
    try:
        return path.read_text(encoding="utf-8")
    except OSError as err:
        raise SystemExit(f"Could not read {field} file {path}: {err}") from err


def encode_attachment(file_path: str) -> dict[str, str]:
    path = Path(file_path)
    try:
        data = path.read_bytes()
    except OSError as err:
        raise SystemExit(f"Could not read attachment {path}: {err}") from err
    content_type = mimetypes.guess_type(path.name)[0] or "application/octet-stream"
    return {
        "filename": path.name,
        "contentType": content_type,
        "contentBase64": base64.b64encode(data).decode("ascii"),
    }


def build_payload(args: argparse.Namespace) -> dict[str, object]:
    text = read_text_arg(args.body, args.body_file, "body")
    html = read_text_arg(args.html, args.html_file, "html")
    if not text and not html:
        raise SystemExit("Provide --body, --body-file, --html, or --html-file.")

    payload: dict[str, object] = {
        "to": args.to,
        "subject": args.subject,
        "confirm": True,
    }
    if args.from_email:
        payload["fromEmail"] = args.from_email
    if args.sender_uid:
        payload["senderUid"] = args.sender_uid
    if args.sender_key:
        payload["senderKey"] = args.sender_key
    if args.use_owner_auth:
        payload["useOwnerAuth"] = True
    if args.cc:
        payload["cc"] = args.cc
    if args.bcc:
        payload["bcc"] = args.bcc
    if args.reply_to:
        payload["replyTo"] = args.reply_to
    if text:
        payload["text"] = text
    if html:
        payload["html"] = html
    if args.attach:
        payload["attachments"] = [encode_attachment(item) for item in args.attach]
    return payload


def dry_run_summary(payload: dict[str, object], api_url: str) -> dict[str, object]:
    attachments = payload.get("attachments")
    return {
        "dryRun": True,
        "apiUrl": api_url,
        "to": payload.get("to"),
        "fromEmail": payload.get("fromEmail"),
        "cc": payload.get("cc"),
        "bcc": payload.get("bcc"),
        "replyTo": payload.get("replyTo"),
        "subject": payload.get("subject"),
        "senderUid": payload.get("senderUid"),
        "hasSenderKey": "senderKey" in payload,
        "useOwnerAuth": payload.get("useOwnerAuth"),
        "hasText": "text" in payload,
        "hasHtml": "html" in payload,
        "attachments": [
            {
                "filename": item.get("filename"),
                "contentType": item.get("contentType"),
                "contentBase64Bytes": len(item.get("contentBase64", "")),
            }
            for item in attachments
        ]
        if isinstance(attachments, list)
        else [],
    }


def senders_url_from_mail_url(api_url: str) -> str:
    value = api_url.rstrip("/")
    if value.endswith("/send"):
        return value[: -len("/send")] + "/senders"
    return value + "/senders"


def get_json(api_url: str, api_key: str) -> dict[str, object]:
    request = urllib.request.Request(
        api_url,
        method="GET",
        headers={"Authorization": f"Bearer {api_key}"},
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            body = response.read().decode("utf-8")
            return json.loads(body) if body else {}
    except urllib.error.HTTPError as err:
        body = err.read().decode("utf-8", errors="replace")
        print(f"Agent Genaie mail bridge failed with HTTP {err.code}: {body}", file=sys.stderr)
        raise SystemExit(1) from err
    except urllib.error.URLError as err:
        print(f"Could not reach Agent Genaie mail bridge: {err}", file=sys.stderr)
        raise SystemExit(1) from err


def post_json(api_url: str, api_key: str, payload: dict[str, object]) -> dict[str, object]:
    data = json.dumps(payload).encode("utf-8")
    request = urllib.request.Request(
        api_url,
        data=data,
        method="POST",
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=45) as response:
            body = response.read().decode("utf-8")
            return json.loads(body) if body else {}
    except urllib.error.HTTPError as err:
        body = err.read().decode("utf-8", errors="replace")
        print(f"Agent Genaie mail bridge failed with HTTP {err.code}: {body}", file=sys.stderr)
        raise SystemExit(1) from err
    except urllib.error.URLError as err:
        print(f"Could not reach Agent Genaie mail bridge: {err}", file=sys.stderr)
        raise SystemExit(1) from err


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="genaie-mail")
    subparsers = parser.add_subparsers(dest="command", required=True)
    default_mail_url = mail_url()
    default_api_key = env_default("AGENT_GENAI_INTERNAL_API_KEY", "")

    send = subparsers.add_parser("send", help="send mail through the Agent Genaie Gmail bridge")
    send.add_argument("--from", dest="from_email", help="registered sender email with connected Gmail")
    send.add_argument("--sender-uid", help="Firebase UID for the connected Gmail sender")
    send.add_argument("--sender-key", help="backend sender key for the connected Gmail sender")
    send.add_argument("--use-owner-auth", action="store_true", help="use the configured owner Gmail sender")
    send.add_argument("--to", action="append", required=True, help="recipient address; repeat for multiple")
    send.add_argument("--cc", action="append", help="cc address; repeat for multiple")
    send.add_argument("--bcc", action="append", help="bcc address; repeat for multiple")
    send.add_argument("--reply-to", help="reply-to address")
    send.add_argument("--subject", required=True)
    body_group = send.add_mutually_exclusive_group()
    body_group.add_argument("--body")
    body_group.add_argument("--body-file")
    html_group = send.add_mutually_exclusive_group()
    html_group.add_argument("--html")
    html_group.add_argument("--html-file")
    send.add_argument("--attach", action="append", help="attachment path; repeat for multiple")
    send.add_argument("--api-url", default=default_mail_url)
    send.add_argument("--api-key", default=default_api_key)
    send.add_argument("--dry-run", action="store_true", help="print sanitized payload summary and do not send")
    send.add_argument("--force", action="store_true", help="required to actually send mail")

    senders = subparsers.add_parser("senders", help="list registered users who connected Gmail")
    senders.add_argument("--api-url", default=senders_url_from_mail_url(default_mail_url))
    senders.add_argument("--api-key", default=default_api_key)
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    if args.command == "senders":
        if not args.api_key:
            print("Missing AGENT_GENAI_INTERNAL_API_KEY.", file=sys.stderr)
            return 2
        print(json.dumps(get_json(args.api_url, args.api_key), indent=2))
        return 0

    if args.command != "send":
        parser.error("unknown command")

    payload = build_payload(args)
    if args.dry_run:
        print(json.dumps(dry_run_summary(payload, args.api_url), indent=2))
        return 0
    if not args.force:
        print("Refusing to send without --force. Use --dry-run to inspect the request.", file=sys.stderr)
        return 2
    if not args.api_key:
        print("Missing AGENT_GENAI_INTERNAL_API_KEY.", file=sys.stderr)
        return 2

    result = post_json(args.api_url, args.api_key, payload)
    print(json.dumps(result, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
