#!/usr/bin/env python3
"""Installer check: 0 active, 3 retired, 1 unavailable (do not install)."""
from pathlib import Path
import sys
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import campaign_deletion as deletion

if __name__ == "__main__":
    try:
        slug = sys.argv[1]
        if slug in ("--schedule", "--apply-schedule", "--schedules"):
            import json
            import console_schedule as schedule
            import promo_config
            import console_campaigns
            if promo_config.mode()[0] != "firestore":
                print("{}")
                sys.exit(0)
            if slug == "--schedules":
                _, raw = deletion.config.fetch(include_groups=False)
                overrides = {}
                for key, fields in raw.get("campaigns", []):
                    doc = deletion.config.decode_fields(fields)
                    if not doc.get("deleted") and doc.get("scheduleOverride"):
                        schedule.parse(doc["scheduleOverride"])
                        overrides[key] = doc["scheduleOverride"]
                print(json.dumps(overrides))
            else:
                key = deletion.valid_slug(sys.argv[2])
                with deletion.scheduler_lock():
                    doc = deletion.live_campaign(key)
                    if doc.get("kind") == "console":
                        sys.stderr.write("This campaign is data-defined; its reconciler owns the job. Do not run the script installer.\n")
                        sys.exit(4)
                    override = doc.get("scheduleOverride") if not doc.get("deleted") else None
                    if override:
                        schedule.parse(override)
                        if slug == "--apply-schedule":
                            declared = schedule.declarations().get(key)
                            schedule.apply_builtin(doc, declared, console_campaigns.gateway)
                    print(json.dumps(override or {}))
            sys.exit(0)
        if slug == "--deleted":
            import json
            if deletion.enabled():
                _, raw = deletion.config.fetch()
                print(json.dumps(sorted(deletion.deleted_slugs(raw))))
            else:
                print("[]")
            sys.exit(0)
        if deletion.enabled() and deletion.live_campaign(slug).get("deleted") is True:
            sys.exit(3)
    except Exception as ex:
        sys.stderr.write("Cannot verify campaign retirement (%s); refusing cron installation.\n" % type(ex).__name__)
        sys.exit(1)
