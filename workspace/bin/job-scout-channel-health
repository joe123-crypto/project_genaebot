#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd -- "$script_dir/.." && pwd -P)"
source_root="${JOB_SCOUT_SOURCE_ROOT:-}"
if [ -z "$source_root" ]; then
  if [ -f "$repo_root/channel_health.py" ]; then
    source_root="$repo_root"
  elif [ -f "$repo_root/job-scout/channel_health.py" ]; then
    source_root="$repo_root/job-scout"
  else
    printf 'unable to locate channel_health.py; set JOB_SCOUT_SOURCE_ROOT\n' >&2
    exit 1
  fi
fi
[ -f "$source_root/channel_health.py" ] || {
  printf 'channel_health.py was not found under JOB_SCOUT_SOURCE_ROOT=%s\n' "$source_root" >&2
  exit 1
}

exec python3 "$source_root/channel_health.py" "$@"
