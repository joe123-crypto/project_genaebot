#!/usr/bin/env python3
"""Print the operator console's read model as JSON: groups, campaigns, a
per-campaign preview, or an overview of all three.

Read-only. Every number here comes from the bot's own modules rather than a
reimplementation, so the console can never disagree with what the cron will
actually send: the group table, caps and rotation from promo_membership and
promo_caps, the caption variant and ref code from promo_broadcast, and each
campaign's copy, tracking and schedule from its own Firestore document.

Every campaign is data-defined. The copy that used to be read by importing a
post script, and the schedule that used to come from a committed cron manifest,
are fields on ``campaigns/<slug>`` like everything else.

It never changes operator config or contacts the gateway. Private display caches
and outage snapshots live on the state volume.

Usage:
  console-read overview [--date YYYY-MM-DD]
  console-read groups [--date YYYY-MM-DD]
  console-read campaigns [--date YYYY-MM-DD]
  console-read preview SLUG [--date YYYY-MM-DD]

All commands accept --fresh-config to bypass display caches and require live
Firestore configuration. Campaign sends and writers never use the display cache.

Prints one JSON document on stdout. On failure prints {"error": ...} and exits
non-zero, so a caller never has to parse a traceback.

Std-lib only.
"""

import io
import json
import os
import sys
import time
import urllib.request
from datetime import date
from functools import partial
from pathlib import Path

WORKSPACE = Path(__file__).resolve().parents[1]
LIB_DIR = str(WORKSPACE / "lib")
if LIB_DIR not in sys.path:
    sys.path.insert(0, LIB_DIR)

import promo_membership  # noqa: E402
import promo_caps  # noqa: E402
import promo_broadcast  # noqa: E402
import ad_assets  # noqa: E402
import promo_config  # noqa: E402
import console_campaigns
import console_schedule
import operator_config  # noqa: E402
import console_config  # noqa: E402
import operator_writer  # noqa: E402
import group_discovery  # noqa: E402
import group_metrics  # noqa: E402

COMMANDS = ("overview", "groups", "campaigns", "preview", "captions", "campaign", "campaign-state", "campaign-groups", "capabilities", "settings", "navigation", "group", "groups-by-id")


# Exit codes, so a caller can tell "you asked for something that is not here"
# from "this tool could not do its job" without parsing the message.
EXIT_ERROR = 1
EXIT_NOT_FOUND = 3


class BridgeError(Exception):
    """A condition the caller should see as a message, not a traceback."""


class ConfigReadError(BridgeError):
    def __init__(self, message, metadata):
        super().__init__(message)
        self.metadata = metadata


class NotFound(BridgeError):
    """The caller named something that does not exist."""


def parse_args(args):
    """Hand-rolled like the sibling tools: a command, an optional slug, --date."""
    command = None
    slug = None
    day = None
    rest = list(args)
    while rest:
        token = rest.pop(0)
        if token == "--date":
            if not rest:
                raise BridgeError("--date wants YYYY-MM-DD")
            day = rest.pop(0)
        elif token == "--fresh-config":
            pass  # main supplies the strict loader; not a positional argument.
        elif token.startswith("--"):
            raise BridgeError("unknown option %r" % token)
        elif command is None:
            command = token
        elif slug is None:
            slug = token
        else:
            raise BridgeError("unexpected argument %r" % token)
    if command not in COMMANDS:
        raise BridgeError("command must be one of %s" % ", ".join(COMMANDS))
    if command in ("preview", "captions", "campaign", "campaign-state", "campaign-groups", "group", "groups-by-id") and not slug:
        raise BridgeError("%s needs a campaign slug" % command)
    return command, slug, day


def parse_day(raw):
    if not raw:
        return date.today()
    try:
        return date(*(int(part) for part in raw.split("-")))
    except (TypeError, ValueError) as exc:
        raise BridgeError("--date wants YYYY-MM-DD, got %r" % raw) from exc


_RESOLVED = {}
_FRESH_CONFIG = False
_CAMPAIGN_SCOPE = None
_INCLUDE_GROUPS = True
_INCLUDE_CAMPAIGNS = True
_GROUP_IDS = None


def resolved():
    """The operator config this console reads, resolved the same way a campaign
    run resolves it, once per invocation. The console must never show the file
    while production acts on Firestore -- that is how an operator ends up sure a
    group is paused when it is not.

    Notes from the read are collected rather than printed: stdout is the JSON
    document and callers parse it, so they reach the payload instead."""
    if "config" not in _RESOLVED:
        notes = io.StringIO()
        try:
            _RESOLVED["config"] = promo_config.resolve(None, err=notes, config_loader=partial(
                                                       console_config.load, fresh=_FRESH_CONFIG,
                                                       campaign=_CAMPAIGN_SCOPE, group_ids=_GROUP_IDS,
                                                       include_groups=_INCLUDE_GROUPS, include_campaigns=_INCLUDE_CAMPAIGNS))
        except (operator_config.ConfigUnavailable, operator_config.ConfigInvalid) as exc:
            raise ConfigReadError("no operator config to read: %s" % exc,
                                  getattr(exc, "metadata", {})) from exc
    return _RESOLVED["config"]


def membership():
    """The operator config, in the shape the caps and targeting read. It is built
    from the store; there is no file behind it any more."""
    loaded = resolved()["membership"]
    if loaded is None:
        raise BridgeError("the operator config could not be read")
    return loaded


def disabled_promos(day=None):
    """Slugs that are switched off, by either switch: the operator's pause
    control in the store, or the gateway having no verified cron to fire them.
    They stay configured on their groups and their copy is still worth
    previewing, but nothing here may predict a send for one."""
    disabled = set()
    for slug, campaign in console_campaigns.definitions(membership()).items():
        if (not resolved().get("storeSwitches", resolved()["switches"]).get(slug, False)
                or campaign.get("scheduleStatus") != "ready"
                or (day and console_campaigns.schedule_minutes(campaign, day) is None)):
            disabled.add(slug)
    return disabled


# ---------------------------------------------------------------------------
# groups
# ---------------------------------------------------------------------------

def group_rows(day):
    """One record per known group: the membership fields plus today's cap and
    which campaigns today's rotation hands that allowance to. Mirrors
    list-groups --json --caps and stays read-only, so it never records a
    cap snapshot."""
    m = membership()
    groups = promo_membership.groups(m)
    disabled = disabled_promos(day)
    decisions = promo_caps.plan(m, list(groups), day=day, record=False,
                                disabled=disabled)

    rows = []
    for jid, entry in groups.items():
        decision = decisions.get(jid) or {}
        weekly = entry.get("weekly") or {}
        allowed = decision.get("allowed")
        # ``allowed`` is None for a group with no cap decision, which means every
        # targeted promo may post. Either way a switched-off campaign is dropped:
        # it installs no cron, so counting it would promise a send that cannot
        # happen. The fallback goes through promos_for_group for the same reason:
        # a campaign the group is paused for cannot post to it today.
        today = (sorted(allowed) if allowed is not None
                 else promo_membership.promos_for_group(m, jid))
        rows.append(
            {
                "jid": jid,
                "name": entry.get("name"),
                "source": entry.get("source"),
                "status": promo_membership.status_of(entry),
                "activity": promo_membership.activity_of(m, entry),
                "account": promo_membership.account_of(entry),
                "dailyCapOverride": entry.get("daily_cap"),
                "promos": list(entry.get("promos") or []),
                # The assignments still stand (``promos``); these are the ones on
                # hold for this group. Shipped as its own list so a screen can
                # show "paused" without recomputing it.
                "pausedPromos": list(entry.get("paused_promos") or []),
                "weekly": {key: [str(token) for token in value] for key, value in weekly.items()},
                "note": entry.get("note"),
                "cap": decision.get("cap"),
                "replyScore": decision.get("score"),
                "allowedToday": [promo for promo in today if promo not in disabled],
            }
        )
    return rows


def accounts(m):
    numbers = promo_membership.account_numbers(m) or {}
    contact = (m.get("defaults") or {}).get("contact_account")
    return [
        {"id": account, "number": number, "isContact": account == contact}
        for account, number in sorted(numbers.items())
    ]


# ---------------------------------------------------------------------------
# campaigns
# ---------------------------------------------------------------------------

_CATALOGUE = {}


def asset_catalogue():
    """The asset index, read once per bridge run and then remembered.

    ``overview`` and ``campaigns`` both describe every campaign's pictures, and
    a bridge run must not read Firestore twice to say the same thing. The read
    itself is already snapshot-first (see ``ad_assets.catalogue``); this is
    about one process, that one about one console.

    Its notes go to a sink rather than stderr, for the reason ``resolved`` gives:
    stdout is the JSON document and callers parse it, so anything worth saying
    about the index travels in the payload's ``note`` where a screen can show
    it. ``ad_assets`` logs a fallback to the snapshot, which is a normal event
    here and must not look like a bridge that failed."""
    if "value" not in _CATALOGUE:
        notes = io.StringIO()
        try:
            env = dict(os.environ)
            if _CAMPAIGN_SCOPE:
                env["GENAIE_AD_ASSETS_SCOPE"] = _CAMPAIGN_SCOPE
            _CATALOGUE["value"] = ad_assets.catalogue(env, log=lambda m: notes.write(m))
        except Exception as exc:  # the campaigns screen outranks its pictures
            _CATALOGUE["value"] = {"campaigns": {}, "source": None,
                                   "fetchedAt": None,
                                   "note": "%s: %s" % (type(exc).__name__, exc)}
    return _CATALOGUE["value"]


def asset_entries(slug):
    """A campaign's pictures as the console displays them: the index's own
    rotation order, each with the address its bytes are served from.

    Separate from ``images`` rather than replacing it. ``images`` is what the
    campaign's own ``post_ad.py`` declares and, until the R2 cutover, still what
    a run attaches; this is what the index says. They agree today, and the
    console is the right place to notice the day they stop."""
    return [{"filename": entry["filename"],
             "url": entry.get("url"),
             "sha256": entry["sha256"],
             "bytes": entry["bytes"],
             "contentType": entry["content_type"],
             "rank": entry["rank"]}
            for entry in asset_catalogue()["campaigns"].get(slug, [])]


def campaign_records(day, only_slug=None, include_assets=True):
    """Every campaign, from the store. There is no second kind any more: the ten
    that kept their copy in a post script and their schedule in a committed
    manifest are data-defined like the rest, so a record is built once, from one
    place, and ``source`` is always ``console``."""
    m = membership()
    records = console_campaigns.records(m, day, resolved().get("storeSwitches"),
                                        only_slug=only_slug)
    deleted = resolved().get("deleted", [])
    records = [row for row in records if row["slug"] not in deleted]
    for row in records:
        doc = (m.get("promos") or {}).get(row["slug"], {})
        row["assets"] = asset_entries(row["slug"]) if include_assets else row.get("assets", [])
        row.update(console_schedule.read_fields(doc, day))
    records.sort(key=lambda row: (row["hour"] if row["hour"] is not None else 99, row["minute"] or 0))
    return records


# ---------------------------------------------------------------------------
# preview
# ---------------------------------------------------------------------------

def preview(slug, day):
    """Per-group caption variant, ref code and link for one campaign.

    Uses the engine's own caption_for/ref_code helpers, so the preview is the
    same text the cron would send.
    """
    m = membership()
    if slug in resolved().get("deleted", []):
        raise NotFound("campaign has been deleted")

    custom = console_campaigns.definitions(m).get(slug)
    if custom is None:
        raise NotFound("unknown campaign %r" % slug)
    enabled = (resolved().get("storeSwitches", resolved()["switches"]).get(slug, False)
               and custom.get("scheduleStatus") == "ready")
    captions = custom["captions"]
    tracking = custom.get("tracking", {})

    occurrence = console_campaigns.schedule_occurrence(custom, day) if custom else None
    caption_day = occurrence[0] if occurrence else day

    # Every assignment, paused ones included: this is the campaign's "where it
    # goes" list, and a paused group missing from it could never be resumed.
    # Each row says whether it is paused; sendsToday is what actually happens.
    daily_jids, weekly_jids = promo_membership.groups_for_promo(
        m, slug, include_paused=True)
    all_jids = list(daily_jids) + list(weekly_jids)
    decisions = promo_caps.plan(m, list(promo_membership.groups(m)), day=day, record=False,
                                disabled=disabled_promos(day))
    numbers = promo_membership.account_numbers(m) or {}
    contact_account = (m.get("defaults") or {}).get("contact_account")
    entries = promo_membership.groups(m)

    rows = []
    for jid in all_jids:
        group = entries.get(jid, {})
        decision = decisions.get(jid) or {}
        allowed = decision.get("allowed")
        account = promo_membership.account_of(group)
        # The advertised number is the configured contact line when one is set,
        # otherwise whichever line actually posts to this group.
        bot_number = numbers.get(contact_account) if contact_account else None
        bot_number = tracking.get("number") or bot_number or numbers.get(account)

        # caption_for's ``allowed`` is the group's posting WEEKDAYS, so a weekly
        # group's variants still step by one per actual post. It is not the caps
        # decision. Daily groups pass None.
        weekdays = [
            promo_broadcast._parse_weekday(token)
            for token in (weekly_jids.get(jid) or [])
        ]
        weekdays = sorted({index for index in weekdays if index is not None}) or None

        variant, rendered, ref = None, None, None
        if captions:
            variant, rendered, ref = promo_broadcast.caption_for(
                jid, captions, day=caption_day, allowed=weekdays,
                tracking=tracking, bot_number=bot_number,
            )

        paused = slug in promo_membership.paused_of(group)
        rows.append(
            {
                "jid": jid,
                "name": group.get("name"),
                "account": account,
                "contactNumber": tracking.get("number") or bot_number,
                "ref": ref,
                "variant": variant,
                "caption": rendered,
                "cap": decision.get("cap"),
                "paused": paused,
                "sendsToday": (enabled and not paused
                               and (not custom or occurrence is not None)
                               and (not weekdays or caption_day.weekday() in weekdays)
                               and (allowed is None or slug in allowed)),
                "allowedToday": sorted(allowed) if allowed is not None else [],
                "weekly": [str(token) for token in (weekly_jids.get(jid) or [])],
            }
        )
    return {"slug": slug, "enabled": enabled, "captions": captions,
            "tracking": tracking, "groups": rows}


# ---------------------------------------------------------------------------
# overview
# ---------------------------------------------------------------------------

def config_source_status():
    """Where this read model came from, so a screen can say so rather than leave
    the operator guessing which store they are looking at. ``source`` is
    ``"firestore"`` for a live read and ``"snapshot"`` when Firestore was
    unreachable and the last-known-good copy was served. ``quarantined`` lists
    the groups Firestore holds but no run will post to, which is otherwise
    invisible outside the run logs."""
    config = resolved()
    report = config.get("report") or {}
    return {"mode": config["mode"], "source": config["source"],
            "quarantined": sorted((report.get("quarantined") or {})),
            "warnings": list(report.get("warnings") or []),
            "notes": list(config.get("notes") or [])}


def ad_assets_status():
    """Where the ad images come from, what the newest asset check found, and
    what the index the console displays from says right now.

    ``lastCheck`` is the single newest check across all campaigns, not one per
    campaign: each run overwrites it, so the console shows whichever campaign
    ran last. Its ``campaign`` field says which, and ``checkedAt`` tells a
    current result from one left over after the mode was switched back.

    ``mode`` is what a RUN attaches; ``source``, ``fetchedAt`` and ``note``
    describe the index, which is read whatever the mode is. The two are
    deliberately not tied together: the index is accurate before the cutover as
    well as after, and a console that showed no pictures until ``r2`` was
    switched on would be hiding exactly the thing the cutover is about. ``note``
    is the one place an index that could not be read is explained, so a screen
    can say why rather than imply a campaign has no picture."""
    current, warning = ad_assets.mode()
    catalogue = asset_catalogue()
    return {"mode": current, "warning": warning,
            "lastCheck": ad_assets.read_result(),
            "source": catalogue["source"],
            "fetchedAt": catalogue["fetchedAt"],
            "note": catalogue["note"]}


def deletion_records():
    import campaign_deletion
    if not campaign_deletion.enabled():
        return []
    # API reads already hold the writer credential. Use its separate token cache.
    # A direct local read can use read-only credentials for this collection too.
    env = dict(os.environ)
    key = env.get("GCP_SERVICE_ACCOUNT_WRITE_B64")
    if key:
        env["GCP_SERVICE_ACCOUNT_B64"] = key
        env.pop("GCP_SERVICE_ACCOUNT_FILE", None)
        env["GENAIE_FIRESTORE_DIR"] = str(Path(operator_config.state_dir()) / "writer")
    creds = operator_config.credentials(env)
    if not creds:
        raise BridgeError("cannot read campaign deletion status")
    token = operator_config.access_token(creds, operator_config.token_cache_path(operator_config.state_dir(env)),
        opener=urllib.request.urlopen,
        signer=operator_config.node_signer, now=time.time, sleep=time.sleep)
    rows = operator_config.list_documents(creds["project_id"], "campaign_deletions", token, opener=urllib.request.urlopen, sleep=time.sleep)
    return [campaign_deletion.summary(slug, operator_config.decode_fields(fields)) for slug, fields in rows]


def write_capabilities():
    """What a console may offer to change, straight from the writer that will
    judge it, so no screen can present an edit the bot is going to refuse.

    ``enabled`` is whether this process holds the write key. The console API is
    the only process the entrypoint hands it to, and this runs as its child, so
    that is exactly whether a write would be accepted; only the variable's
    presence is checked, never its value. ``affectsProduction`` says whether a
    saved change reaches the campaigns: before the cutover a write lands in
    Firestore while runs still act on membership.json."""
    current, _ = promo_config.mode()
    return {
        "enabled": bool((os.environ.get("GCP_SERVICE_ACCOUNT_WRITE_B64") or "").strip()),
        "affectsProduction": current == promo_config.FIRESTORE,
        "fields": dict((collection, list(names))
                       for collection, names in operator_writer.EDITABLE.items()),
        "delete": list(operator_writer.DELETABLE),
        "campaignDeletion": __import__("campaign_deletion").capability(),
        "scheduleEditing": {"edit": current == promo_config.FIRESTORE and os.path.isfile(str(Path(__file__).with_name("console-schedule")))},
        "campaignCreation": {"create": current == promo_config.FIRESTORE,
                             "images": ad_assets.mode()[0] == "r2" and bool(ad_assets.base_url()),
                             "scheduling": True},
    }


def action_capabilities():
    """What the console may offer to DO to a group, as opposed to change about
    it: take the account's number out of the WhatsApp group, and forget what the
    bot stored about it.

    Reported apart from ``writes`` on purpose. ``writes.enabled`` means exactly
    "this process holds the Firestore write key", and neither of these touches
    Firestore -- gating them on that key would hide a working control behind a
    credential it does not use. What gates them is this bot knowing how: the
    bridge that performs them has to be on the volume, and leaving also needs
    the monitor's helper, which GENAIE_GROUP_ACTIONS=0 switches off.

    A console reading an older bot finds this absent, and must take that as
    "cannot", never as "everything is available"."""
    switched_off = (os.environ.get("GENAIE_GROUP_ACTIONS") or "").strip() == "0"
    present = os.path.isfile(str(Path(__file__).resolve().parent / "console-group-action"))
    return {
        "leaveGroup": bool(present and not switched_off),
        "clearRecords": bool(present and not switched_off),
    }


def cap_settings(m):
    """The settings every group's daily allowance is derived from, in the shape a
    form edits them: the switch, the tier a group without one falls into, and each
    tier's band as ``[low, high]``."""
    defaults = (m or {}).get("defaults") or {}
    return {
        "enabled": promo_membership.caps_enabled(m),
        "defaultActivity": defaults.get("activity") or promo_membership.DEFAULT_ACTIVITY,
        "bands": dict((tier, [low, high]) for tier, (low, high)
                      in sorted(promo_membership.bands(m).items())),
    }


def overview(day):
    m = membership()
    groups = promo_membership.groups(m)

    by_status = {}
    for entry in groups.values():
        status = entry.get("status", "active")
        by_status[status] = by_status.get(status, 0) + 1

    campaigns = campaign_records(day, include_assets=False)
    rows = group_rows(day)
    planned = sum(len(row["allowedToday"]) for row in rows if row["status"] == "active")

    return {
        "date": day.isoformat(),
        "groupsByStatus": by_status,
        "groupTotal": len(groups),
        "campaignTotal": len(campaigns),
        "deletedCampaigns": resolved().get("deleted", []),
        "plannedSendsToday": planned,
        "accounts": accounts(m),
        "capsEnabled": bool((m.get("defaults") or {}).get("caps_enabled")),
        "capSettings": cap_settings(m),
        "writes": write_capabilities(),
        "actions": action_capabilities(),
        "configSource": config_source_status(),
        "campaigns": campaigns,
    }


def campaign_edit_state(slug, captions_only=False):
    """Save-time checks need one campaign document, no targeting or cap data."""
    import urllib.request
    import time
    try:
        creds = operator_config.credentials()
        if creds is None:
            raise operator_config.ConfigUnavailable("no service account configured")
        token = operator_config.access_token(creds,
            operator_config.token_cache_path(operator_config.state_dir()),
            opener=urllib.request.urlopen, signer=operator_config.node_signer,
            now=time.time, sleep=time.sleep)
        doc = operator_config.get_document(creds["project_id"], "campaigns", slug, token,
            opener=urllib.request.urlopen, sleep=time.sleep)
    except operator_config.ConfigUnavailable as exc:
        raise ConfigReadError("campaign config unavailable: %s" % exc, exc.metadata) from exc
    except ValueError as exc:
        raise BridgeError("campaign config cannot be decoded") from exc
    switch = (doc or {}).get("enabled", True)
    store_on = switch if isinstance(switch, bool) else False
    if doc and doc.get("deleted") is True:
        if captions_only:
            raise NotFound("campaign has been deleted")
        return {"campaign": None}
    if not doc or doc.get("kind") != "console":
        if captions_only:
            raise NotFound("unknown campaign %r" % slug)
        return {"campaign": None}
    # The second switch: a campaign is only on once the reconciler has verified
    # the gateway is running the schedule its document asks for.
    cron_on = doc.get("scheduleStatus") == "ready"
    enabled = store_on and cron_on
    if not captions_only:
        return {"campaign": {"slug": slug, "enabled": enabled, "storeEnabled": store_on, "cronEnabled": cron_on}}
    try:
        if "captions" not in doc:
            raise BridgeError("campaign has no caption variants")
        captions = operator_config.validate_captions(doc["captions"])
    except operator_config.ConfigInvalid as exc:
        raise BridgeError(str(exc)) from exc
    return {"slug": slug, "enabled": enabled, "captions": captions, "tracking": {}, "groups": []}


def navigation():
    """Sidebar counts do not need group records, previews, captions or assets."""
    def read():
        import urllib.request
        import time
        creds = operator_config.credentials()
        if creds is None:
            raise operator_config.ConfigUnavailable("no service account configured")
        token = operator_config.access_token(creds,
            operator_config.token_cache_path(operator_config.state_dir()),
            opener=urllib.request.urlopen, signer=operator_config.node_signer,
            now=time.time, sleep=time.sleep)
        def count(collection, field, value):
            return operator_config.count_documents(creds["project_id"], collection, token,
                where={"fieldFilter": {"field": {"fieldPath": field}, "op": "IN" if isinstance(value, list) else "EQUAL",
                                       "value": operator_config.encode_value(value)}},
                opener=urllib.request.urlopen, sleep=time.sleep)
        review = count("groups", "status", ["on-hold", "admin-only", "not-a-member"])
        # Every campaign is data-defined, so this is one count and no
        # subtraction: there is no committed list to add in and no converted
        # campaign appearing in both.
        total = count("campaigns", "kind", "console")
        if __import__("campaign_deletion").enabled():
            retired = operator_config.query_documents(creds["project_id"], "campaigns",
                {"fieldFilter": {"field": {"fieldPath": "deleted"}, "op": "EQUAL", "value": {"booleanValue": True}}},
                token, opener=urllib.request.urlopen, sleep=time.sleep)
            total -= len({slug for slug, fields in retired})
        return {"campaignTotal": max(total, 0), "groupsNeedingReview": review}
    try:
        return console_config.cached_summary("navigation", read)
    except operator_config.ConfigUnavailable as exc:
        raise ConfigReadError("sidebar counts unavailable: %s" % exc, exc.metadata) from exc


def main(argv):
    global _FRESH_CONFIG, _CAMPAIGN_SCOPE, _INCLUDE_GROUPS, _GROUP_IDS, _INCLUDE_CAMPAIGNS
    _FRESH_CONFIG = "--fresh-config" in argv
    try:
        command, slug, raw_day = parse_args(argv)
        _CAMPAIGN_SCOPE = slug if command in ("preview", "campaign", "campaign-groups") else None
        _INCLUDE_GROUPS = command not in ("settings", "captions")
        _INCLUDE_CAMPAIGNS = command != "settings"
        _GROUP_IDS = [slug] if command == "group" else slug.split(",") if command == "groups-by-id" else None
        day = parse_day(raw_day)
        if command == "capabilities":
            payload = {"writes": write_capabilities()}
        elif command == "settings":
            payload = {"capSettings": cap_settings(membership()), "writes": write_capabilities(),
                       "accounts": accounts(membership())}
        elif command == "navigation":
            payload = navigation()
        elif command == "campaign-state":
            payload = campaign_edit_state(slug)
        elif command == "captions":
            payload = campaign_edit_state(slug, captions_only=True)
        elif command in ("groups", "campaign-groups", "group", "groups-by-id"):
            # A group keeps a switched-off campaign in its configured promos, so
            # the screen needs the off list to say WHY one is not posting today.
            # Without it a disabled campaign is indistinguishable from one the
            # daily cap held back.
            payload = {"date": day.isoformat(),
                       "disabledPromos": sorted(disabled_promos(day)),
                       "groups": [row for row in group_rows(day)
                                  if (_GROUP_IDS is None or row["jid"] in _GROUP_IDS)
                                  and (_CAMPAIGN_SCOPE is None or _CAMPAIGN_SCOPE in row["promos"]
                                       or _CAMPAIGN_SCOPE in row["weekly"])],
                       **(group_discovery.read(membership()) if command in ("groups", "group") else {})}
            if command == "group":
                payload["discoveredGroups"] = [row for row in payload.get("discoveredGroups", []) if row["jid"] == slug]
            group_metrics.attach(payload, membership())
            if command in ("groups", "group"):
                # All of this comes from the config already read for the rows;
                # no overview, preview or asset catalogue is needed by a picker.
                deleted = resolved().get("deleted", [])
                choices = [{"slug": slug, "name": row.get("name"),
                            "enabled": bool(resolved().get("storeSwitches", {}).get(slug))
                                       and row.get("scheduleStatus") == "ready"}
                           for slug, row in console_campaigns.definitions(membership()).items()
                           if slug not in deleted]
                payload["context"] = {"writes": write_capabilities(), "actions": action_capabilities(),
                                      "accounts": accounts(membership()), "capSettings": cap_settings(membership()),
                                      "campaigns": choices}
        elif command == "campaigns":
            payload = {"date": day.isoformat(), "adAssets": ad_assets_status(),
                       "campaigns": campaign_records(day), "deletions": deletion_records()}
        elif command == "campaign":
            records = campaign_records(day, only_slug=slug)
            payload = {"date": day.isoformat(), "adAssets": ad_assets_status(),
                       "campaign": records[0] if records else None}
        elif command == "preview":
            payload = preview(slug, day)
        else:
            payload = overview(day)
    except BridgeError as exc:
        json.dump({"error": str(exc), **getattr(exc, "metadata", {})}, sys.stdout)
        sys.stdout.write("\n")
        return EXIT_NOT_FOUND if isinstance(exc, NotFound) else EXIT_ERROR

    json.dump(payload, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
