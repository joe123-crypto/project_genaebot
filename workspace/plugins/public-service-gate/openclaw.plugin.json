{
  "id": "public-service-gate",
  "name": "Public Service Gate",
  "description": "Handles WhatsApp public-user safety and invite access control before agent dispatch.",
  "version": "0.1.0",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": ["public_service"]
  },
  "toolMetadata": {
    "public_service": {
      "optional": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "publicUsers": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "whatsappAdminUsers": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "adminModeEnabled": {
        "type": "boolean"
      },
      "invitesEnabled": {
        "type": "boolean"
      },
      "botWhatsappNumber": {
        "type": "string"
      },
      "inviteRequiredText": {
        "type": "string"
      },
      "invitePendingText": {
        "type": "string"
      },
      "inviteUnlockedText": {
        "type": "string"
      },
      "inviteScript": {
        "type": "string"
      },
      "publicUserScript": {
        "type": "string"
      },
      "greetingTemplatePath": {
        "type": "string"
      },
      "webetuOnboardingStartText": {
        "type": "string"
      },
      "jobScoutOnboardingEnabled": {
        "type": "boolean"
      },
      "workerSudoCommand": {
        "type": "string"
      },
      "pendingLinksPath": {
        "type": "string"
      },
      "serviceStatePath": {
        "type": "string"
      }
    }
  }
}
