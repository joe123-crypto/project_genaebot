  "attachments": {
    "ttlHours": 168
  },
  "messages": {
    "queue": {
      "mode": "steer",
      "byChannel": {
        "whatsapp": "steer"
      }
    }
  },
  "session": {
    "dmScope": "per-account-channel-peer"
  },
  "tools": {
    "subagents": {
      "tools": {
        "allow": ["exec", "process", "read", "edit", "write"],
        "deny": ["message", "gateway", "cron", "sessions_spawn", "sessions_send", "sessions_list", "sessions_history", "subagents", "agents_list"]
      }
    },
    "elevated": {
      "enabled": false
    }
  },
  "secrets": {
    "providers": {
      "dotenv": {
        "source": "env",
        "allowlist": [
          "OPENROUTER_API_KEY",
          "AI_GATEWAY_API_KEY",
          "GATEWAY_AUTH_TOKEN",
          "AGENT_GENAI_INTERNAL_API_KEY",
          "JSEARCH_API_KEY",
          "JSEARCH_RAPIDAPI_KEY",
          "JSEARCH_RAPIDAPI_HOST",
