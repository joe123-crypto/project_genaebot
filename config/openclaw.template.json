      },
      "xurl": {
        "enabled": false
      }
    }
  },
  "media": {
    "ttlHours": 168
  },
  "messages": {
    "queue": {
      "mode": "steer",
      "byChannel": {
        "whatsapp": "steer"
      }
    }
  },
  "session": {
    "dmScope": "per-account-channel-peer"
  },
  "tools": {
    "elevated": {
      "enabled": false
    }
  },
  "secrets": {
    "providers": {
      "dotenv": {
        "source": "env",
        "allowlist": [
          "AI_GATEWAY_API_KEY",
          "GATEWAY_AUTH_TOKEN",
          "AGENT_GENAI_INTERNAL_API_KEY",
          "JSEARCH_API_KEY",
          "JSEARCH_RAPIDAPI_KEY",
          "JSEARCH_RAPIDAPI_HOST",
          "JSEARCH_PROVIDER"
        ]
      }
    }
  }
