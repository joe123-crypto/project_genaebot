{
  "gateway": {
    "auth": {
      "mode": "token",
      "token": {
        "source": "env",
        "provider": "dotenv",
        "id": "GATEWAY_AUTH_TOKEN"
      }
    },
    "mode": "local",
    "bind": "loopback",
    "tailscale": {
      "mode": "off"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "vercel-ai-gateway/deepseek/deepseek-v4-pro",
        "fallbacks": [
          "vercel-ai-gateway/deepseek/deepseek-v4-pro"
        ]
      },
      "workspace": "/home/joseph/.openclaw/agent-workspace-admin",
      "typingMode": "instant",
      "typingIntervalSeconds": 6,
      "blockStreamingDefault": "off",
      "blockStreamingBreak": "text_end",
      "blockStreamingChunk": {
        "minChars": 500,
        "maxChars": 900
      },
      "blockStreamingCoalesce": {
        "idleMs": 1200
      },
      "timeoutSeconds": 1800,
      "subagents": {
        "allowAgents": ["main"],
        "maxConcurrent": 4,
        "maxSpawnDepth": 1,
        "maxChildrenPerAgent": 4,
        "runTimeoutSeconds": 2700
      },
      "memorySearch": {
        "provider": "openai-compatible",
        "model": "google/text-embedding-005",
        "remote": {
          "baseUrl": "https://ai-gateway.vercel.sh/v1",
          "apiKey": {
            "source": "env",
            "provider": "dotenv",
            "id": "AI_GATEWAY_API_KEY"
          }
        }
      },
      "thinkingDefault": "max"
    },
    "list": [
      {
        "id": "main",
        "default": true,
        "workspace": "/home/joseph/.openclaw/agent-workspace-admin",
        "subagents": {
          "allowAgents": ["main"]
        },
        "tools": {
          "alsoAllow": ["sessions_spawn", "sessions_yield", "subagents"]
        }
      },
      {
        "id": "public",
        "workspace": "/home/joseph/.openclaw/agent-workspace-public",
        "memorySearch": {
          "enabled": false
        },
        "tools": {
          "allow": ["public_service"],
          "deny": ["exec", "process", "read", "write", "edit", "apply_patch", "browser", "gateway", "cron", "sessions_list", "sessions_history", "sessions_send", "subagents", "agents_list", "message"]
        }
      }
    ]
  },
  "bindings": [
    {
      "agentId": "public",
      "match": {
        "channel": "whatsapp",
        "accountId": "*",
        "peer": { "kind": "direct", "id": "*" }
      }
    },
    {
      "agentId": "main",
      "match": {
        "channel": "whatsapp",
        "accountId": "*",
        "peer": { "kind": "group", "id": "*" }
      }
    }
  ],
  "plugins": {
    "entries": {
      "vercel-ai-gateway": {
        "enabled": true
      },
      "whatsapp": {
        "enabled": true
      },
      "voice-call": {
        "enabled": true,
        "config": {
          "provider": "mock",
          "sessionScope": "per-phone",
          "outbound": {
            "defaultMode": "conversation"
          },
          "inboundPolicy": "disabled"
        }
      },
      "public-service-gate": {
        "enabled": true,
        "config": {
          "enabled": true,
          "greetingTemplatePath": "/home/joseph/.openclaw/workspace/docs/public-greeting.txt",
          "webetuOnboardingStartText": "Sign in here and save your Webetu details in the Credentials Vault:\n{setupUrl}\n\nDon't send those details here. Check Spam if the sign-in email doesn't arrive.",
          "botWhatsappNumber": "+263785632943",
          "memberGateEnabled": true,
          "webetuEnabled": false,
          "newsEnabled": false,
          "eventScoutEnabled": false,
          "jobScoutOnboardingEnabled": true
        }
      },
      "whatsapp-relevance-gate": {
        "enabled": true,
        "config": {
          "enabled": false,
          "serviceSummary": "Job, scholarship, and internship scouting and applications",
          "serviceKeywords": [
            "job",
            "jobs",
            "scholarship",
            "internship",
            "apply",
            "application",
            "hi",
            "hello",
            "hey",
            "salam",
            "bonjour",
            "start",
            "setup",
            "help"
          ],
          "serviceExamples": [
            "find me a job",
            "any scholarships",
            "help me apply for an internship"
          ],
          "relevanceMode": "off",
          "embeddingModel": "google/text-multilingual-embedding-002",
          "relevanceFloor": 0.55,
          "relevanceMargin": 0.05,
          "embeddingFailOpen": true,
          "serviceAnchors": [
            "find me a job",
            "any scholarships I can apply to",
            "help me apply for an internship",
            "ابحث لي عن وظيفة او منحة",
            "how do I get started",
            "help me set up my account"
          ],
          "offTopicAnchors": [
            "what is the weather today",
            "tell me a joke",
            "who won the football match last night",
            "what do you think about politics",
            "what is the price of bitcoin",
            "can you write me a poem",
            "translate this paragraph for me",
            "quelle est la météo aujourd'hui",
            "raconte-moi une blague",
            "ما هي أخبار كرة القدم"
          ],
          "useLlmFallback": false,
          "llmMaxTokens": 5,
          "rejectionMessage": "I can help with Job Scout. Do you want to set it up?",
          "failOpen": false,
          "maxTextLength": 400
        }
      }
    },
    "load": {
      "paths": [
        "/home/joseph/.openclaw/workspace/plugins/public-service-gate",
        "/home/joseph/.openclaw/workspace/plugins/whatsapp-relevance-gate"
      ]
    }
  },
  "web": {
    "enabled": true,
    "whatsapp": {
      "keepAliveIntervalMs": 25000,
      "connectTimeoutMs": 60000,
      "defaultQueryTimeoutMs": 60000
    }
  },
  "channels": {
    "whatsapp": {
      "dmPolicy": "open",
      "selfChatMode": false,
      "sendReadReceipts": false,
      "blockStreaming": true,
      "blockStreamingCoalesce": {
        "minChars": 400,
        "maxChars": 900,
        "idleMs": 1200
      },
      "enabled": true
    }
  },
  "skills": {
    "install": {
      "preferBrew": true
    },
    "entries": {
      "1password": {
        "enabled": false
      },
      "apple-notes": {
