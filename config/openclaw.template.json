{
  "gateway": {
    "auth": {
      "mode": "token",
      "token": {
        "source": "env",
        "provider": "dotenv",
        "id": "GATEWAY_AUTH_TOKEN"
      }
    },
    "mode": "local",
    "bind": "loopback",
    "tailscale": {
      "mode": "off"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openrouter/deepseek/deepseek-v4-pro",
        "fallbacks": [
          "openrouter/deepseek/deepseek-v4-pro"
        ]
      },
      "workspace": "/home/joseph/.openclaw/agent-workspace-admin",
      "typingMode": "instant",
      "typingIntervalSeconds": 6,
      "blockStreamingDefault": "off",
      "blockStreamingBreak": "text_end",
      "blockStreamingChunk": {
        "minChars": 500,
        "maxChars": 900
      },
      "blockStreamingCoalesce": {
        "idleMs": 1200
      },
      "timeoutSeconds": 1800,
      "subagents": {
        "allowAgents": ["main"],
        "maxConcurrent": 4,
        "maxSpawnDepth": 1,
        "maxChildrenPerAgent": 4,
        "runTimeoutSeconds": 2700
      },
      "thinkingDefault": "high",
      "heartbeat": { "agentId": "main" },
      "systemAgent": { "agentId": "main" }
    },
    "ownership": "explicit",
    "entries": {
      "main": {
        "workspace": "/home/joseph/.openclaw/agent-workspace-admin",
        "subagents": {
          "allowAgents": ["main"]
        },
        "tools": {
          "alsoAllow": ["sessions_spawn", "sessions_yield", "subagents"]
        }
      },
      "public": {
        "workspace": "/home/joseph/.openclaw/agent-workspace-public",
        "tools": {
          "allow": ["public_service"],
          "deny": ["exec", "process", "read", "write", "edit", "apply_patch", "browser", "gateway", "cron", "sessions_list", "sessions_history", "sessions_send", "subagents", "agents_list", "message"]
        },
        "memory": {
          "search": {
            "enabled": false
          }
        }
      }
    }
  },
  "memory": {
    "search": {
      "provider": "openai-compatible",
      "model": "google/text-embedding-005",
      "remote": {
        "baseUrl": "https://ai-gateway.vercel.sh/v1",
        "apiKey": {
          "source": "env",
          "provider": "dotenv",
          "id": "AI_GATEWAY_API_KEY"
        }
      }
    }
  },
  "talk": { "agentId": "main" },
  "bindings": [
    {
      "agentId": "public",
      "match": {
        "channel": "whatsapp",
        "accountId": "*",
        "peer": { "kind": "direct", "id": "*" }
      }
    },
    {
      "agentId": "main",
      "match": { "channel": "whatsapp", "accountId": "*" }
    }
  ],
  "plugins": {
    "entries": {
      "openrouter": {
        "enabled": true
      },
      "vercel-ai-gateway": {
        "enabled": true
      },
      "whatsapp": {
        "enabled": true
      },
      "voice-call": {
        "enabled": true,
        "config": {
          "agentId": "main",
          "provider": "mock",
          "sessionScope": "per-phone",
          "outbound": {
            "defaultMode": "conversation"
          },
          "inboundPolicy": "disabled"
        }
      },
      "public-service-gate": {
        "enabled": true,
        "config": {
          "enabled": true,
          "greetingTemplatePath": "/home/joseph/.openclaw/workspace/docs/public-greeting.txt",
          "botWhatsappNumber": "+263785632943",
          "memberGateEnabled": true,
          "pendingAckText": "Thanks for reaching out. Genae grants access manually, so your request has been received and is waiting for review. You'll get a message here once you're approved.",
          "newsEnabled": false,
          "eventScoutEnabled": false,
          "jobScoutOnboardingEnabled": true,
          "cvMakerEnabled": true,
          "cvMakerPriceText": "US$5",
          "cvMakerPaymentDetails": "EcoCash +263783496308 (Charlene Anika)",
          "cvMakerPaymentMethod": "EcoCash"
        }
      },
      "whatsapp-relevance-gate": {
        "enabled": true,
        "config": {
          "enabled": false,
          "serviceSummary": "Job, scholarship, and internship scouting and applications, plus CV writing and revamping",
          "serviceKeywords": [
            "job",
            "jobs",
            "scholarship",
            "internship",
            "apply",
            "application",
            "hi",
            "hello",
            "hey",
            "salam",
            "bonjour",
            "start",
            "setup",
            "help",
            "cv",
            "resume",
            "curriculum vitae"
          ],
          "serviceExamples": [
            "find me a job",
            "any scholarships",
            "help me apply for an internship",
            "make me a cv",
            "revamp my CV"
          ],
          "relevanceMode": "off",
          "embeddingModel": "google/text-multilingual-embedding-002",
          "relevanceFloor": 0.55,
          "relevanceMargin": 0.05,
          "embeddingFailOpen": true,
          "serviceAnchors": [
            "find me a job",
            "any scholarships I can apply to",
            "help me apply for an internship",
            "ابحث لي عن وظيفة او منحة",
            "how do I get started",
            "help me set up my account",
            "make me a professional cv",
            "can you revamp my CV"
          ],
          "offTopicAnchors": [
            "what is the weather today",
            "tell me a joke",
            "who won the football match last night",
            "what do you think about politics",
            "what is the price of bitcoin",
            "can you write me a poem",
            "translate this paragraph for me",
            "quelle est la météo aujourd'hui",
            "raconte-moi une blague",
            "ما هي أخبار كرة القدم"
          ],
          "useLlmFallback": false,
          "llmMaxTokens": 5,
          "rejectionMessage": "I can help with Job Scout or making a CV. Which do you need?",
          "failOpen": false,
          "maxTextLength": 400
        }
      }
    },
    "load": {
      "paths": [
        "/home/joseph/.openclaw/workspace/plugins/public-service-gate",
        "/home/joseph/.openclaw/workspace/plugins/whatsapp-relevance-gate"
      ]
    }
  },
  "channels": {
    "whatsapp": {
      "dmPolicy": "open",
      "groupPolicy": "disabled",
      "selfChatMode": true,
      "sendReadReceipts": false,
      "streaming": {
        "block": {
          "enabled": true,
          "coalesce": {
            "minChars": 400,
            "maxChars": 900,
            "idleMs": 1200
          }
        }
      },
      "enabled": true
    }
  },
  "skills": {
    "install": {
      "preferBrew": true
    },
    "entries": {
      "1password": {
