{
  "gateway": {
    "auth": {
      "mode": "token",
      "token": {
        "source": "env",
        "provider": "dotenv",
        "id": "GATEWAY_AUTH_TOKEN"
      }
    },
    "mode": "local",
    "bind": "loopback",
    "tailscale": {
      "mode": "off"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "vercel-ai-gateway/deepseek/deepseek-v4-pro",
        "fallbacks": [
          "vercel-ai-gateway/deepseek/deepseek-v4-pro"
        ]
      },
      "workspace": "/home/joseph/.openclaw/agent-workspace",
      "typingMode": "instant",
      "typingIntervalSeconds": 6,
      "blockStreamingDefault": "off",
      "blockStreamingBreak": "text_end",
      "blockStreamingChunk": {
        "minChars": 500,
        "maxChars": 900
      },
      "blockStreamingCoalesce": {
        "idleMs": 1200
      },
      "timeoutSeconds": 1800,
      "memorySearch": {
        "provider": "openai-compatible",
        "model": "google/text-embedding-005",
        "remote": {
          "baseUrl": "https://ai-gateway.vercel.sh/v1",
          "apiKey": {
            "source": "env",
            "provider": "dotenv",
            "id": "AI_GATEWAY_API_KEY"
          }
        }
      },
      "thinkingDefault": "max"
    }
  },
  "plugins": {
    "entries": {
      "vercel-ai-gateway": {
        "enabled": true
      },
      "whatsapp": {
        "enabled": true
      },
      "voice-call": {
        "enabled": true,
        "config": {
          "provider": "mock",
          "sessionScope": "per-phone",
          "outbound": {
            "defaultMode": "conversation"
          },
          "inboundPolicy": "disabled"
        }
      },
      "public-service-gate": {
        "enabled": true,
        "config": {
          "enabled": true,
          "greetingTemplatePath": "/home/joseph/.openclaw/workspace/public-greeting.txt",
          "webetuOnboardingStartText": "Open this link and sign in with your email:\n{setupUrl}\n\nAfter sign-in, the app will open your Credentials Vault. Save your Webetu username and password there. Do not send your Webetu username or password here.\n\nThen come back here and tell me which restaurant I should use by default for your meal reservations. I will confirm it with you before saving.\n\nIf the sign-in email does not arrive, check your Spam or Junk folder.",
          "invitesEnabled": true
        }
      },
      "whatsapp-relevance-gate": {
        "enabled": true,
        "config": {
          "enabled": true,
          "serviceSummary": "Webetu Progress meal reservations, personalized news delivery, local event scouting, and job/scholarship/internship scouting and application and inviting friends to the service",
          "serviceKeywords": [
            "meal",
            "reserve",
            "reservation",
            "webetu",
            "restaurant",
            "news",
            "subscribe",
            "subscription",
            "event",
            "job",
            "jobs",
            "scholarship",
            "internship",
            "apply",
            "application",
            "hi",
            "hello",
            "hey",
            "salam",
            "bonjour",
            "start",
            "setup",
            "help",
            "invite",
            "invite link",
            "join"
          ],
          "serviceExamples": [
            "reserve a meal",
            "book a meal at webetu",
            "subscribe me to news",
            "start personalized news",
            "find me a job",
            "any scholarships",
            "what events are near me"
          ],
          "useLlmFallback": false,
          "llmMaxTokens": 5,
          "rejectionMessage": "I can help with Webetu meal reservations, personalized news, local events, and job/scholarship/internship scouting. Which one do you want?",
          "failOpen": false,
          "maxTextLength": 400
        }
      }
    },
    "load": {
      "paths": [
        "/home/joseph/.openclaw/workspace/plugins/public-service-gate",
        "/home/joseph/.openclaw/workspace/plugins/whatsapp-relevance-gate"
      ]
    }
  },
  "web": {
    "enabled": true,
    "whatsapp": {
      "keepAliveIntervalMs": 25000,
      "connectTimeoutMs": 60000,
      "defaultQueryTimeoutMs": 60000
    }
  },
  "channels": {
    "whatsapp": {
      "dmPolicy": "open",
      "selfChatMode": false,
      "sendReadReceipts": false,
      "blockStreaming": true,
      "blockStreamingCoalesce": {
        "minChars": 400,
        "maxChars": 900,
        "idleMs": 1200
      },
      "enabled": true
    }
  },
  "skills": {
    "install": {
      "preferBrew": true
    },
    "entries": {
      "1password": {
        "enabled": false
      },
