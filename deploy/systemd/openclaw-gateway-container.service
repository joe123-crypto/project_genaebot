[Unit]
Description=OpenClaw Gateway Docker Compose stack
Documentation=file:/home/joseph/openclaw-deploy/README.md
Requires=snap.docker.dockerd.service
After=snap.docker.dockerd.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/joseph/openclaw-deploy
ExecStartPre=/usr/local/libexec/openclaw-wait-for-docker
ExecStart=/snap/bin/docker compose up -d --remove-orphans
ExecStop=/snap/bin/docker compose stop
RemainAfterExit=yes
TimeoutStartSec=120
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
