# OpenClaw gateway — Railway image (gateway-only scope).
#
# Build context is the REPOSITORY ROOT (this repo is the single source of truth).
# A first "stage" build phase assembles the curated live-source overlay directly
# from repo HEAD via deploy/stage-openclaw-source.sh, so there is no hand-copied
# live-source/ to drift. The runtime stage bakes that overlay at /opt/live-source;
# the entrypoint syncs it onto the mounted state volume at boot (Railway has no
# host bind-mounts).
#
# Deploy is automatic via Railway's GitHub integration (push to main). See
# deploy/railway/README.md for the wiring and the break-glass `railway up` path.
#
# Differences vs. the Compose image:
#   * live-source is assembled in-build instead of bind-mounted.
#
# Durable OpenClaw state is a Railway volume mounted at /home/joseph/.openclaw
# (seeded once via the Railway CLI — see deploy/railway/README.md).

# ---------------------------------------------------------------------------
# Stage 1: assemble the curated source overlay from repo HEAD.
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS stage

RUN apt-get update \
 && apt-get install -y --no-install-recommends rsync ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src

# Railway exposes the deployed commit as RAILWAY_GIT_COMMIT_SHA; pass it in for
# provenance in the baked overlay marker (best-effort, informational only).
ARG SOURCE_COMMIT=unknown

RUN bash /src/deploy/stage-openclaw-source.sh /src /opt/live-source \
 && bash /src/deploy/verify-staged-source.sh /opt/live-source \
 && printf 'Generated by deploy/railway/Dockerfile\nSource commit: %s\nGenerated at: %s\n' \
      "$SOURCE_COMMIT" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > /opt/live-source/.OPENCLAW_GENERATED

# ---------------------------------------------------------------------------
# Stage 2: the gateway runtime image.
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/joseph \
    OPENCLAW_HOME=/home/joseph/.openclaw \
    OPENCLAW_NO_AUTO_UPDATE=1 \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/joseph/.npm-global/bin

# Poppler renders CV pages and Tesseract recovers headings that embedded PDF
# fonts do not reliably expose to plain text extraction. rsync applies the baked
# source overlay onto the state volume at boot.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-pip \
      poppler-utils tesseract-ocr rsync \
      passwd sudo ca-certificates tini util-linux \
 && rm -rf /var/lib/apt/lists/*

# The node base image ships uid 1000 as `node`; use that uid for the gateway
# account so host-owned bind mounts retain the expected ownership.
RUN userdel -r node 2>/dev/null || true \
 && groupadd -g 1000 joseph \
 && useradd -m -u 1000 -g 1000 -s /bin/bash joseph

RUN npm install -g openclaw@2026.6.34 \
 && npm cache clean --force

# Bake the curated source overlay assembled in stage 1. The entrypoint syncs it
# onto the state volume on every boot (source of truth for workspace/ and the
# agent-workspace-*/*.md context files).
COPY --from=stage /opt/live-source /opt/live-source

COPY deploy/railway/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh

EXPOSE 18789

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
