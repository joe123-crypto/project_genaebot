# OpenClaw gateway — Railway image (gateway-only scope).
#
# Build context is the REPOSITORY ROOT (this repo is the single source of truth).
# A first "stage" build phase assembles the curated live-source overlay directly
# from repo HEAD via deploy/stage-openclaw-source.sh, so there is no hand-copied
# live-source/ to drift. The runtime stage bakes that overlay at /opt/live-source;
# the entrypoint syncs it onto the mounted state volume at boot (Railway has no
# host bind-mounts).
#
# GitHub Actions releases an exact tested main commit after all checks pass.
# See deploy/railway/README.md for token provisioning and the one-time cutover.
#
# Differences vs. the Compose image:
#   * live-source is assembled in-build instead of bind-mounted.
#
# Durable OpenClaw state is a Railway volume mounted at /home/joseph/.openclaw
# (seeded once via the Railway CLI — see deploy/railway/README.md).

# ---------------------------------------------------------------------------
# Stage 1: assemble the curated source overlay from repo HEAD.
# ---------------------------------------------------------------------------
FROM node:26.12.1-bookworm-slim AS stage

RUN apt-get update \
 && apt-get install -y --no-install-recommends rsync ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src

# The release sets SOURCE_COMMIT for Railway build-arg injection. CI verifies
# this baked marker at startup before accepting the deployment.
ARG SOURCE_COMMIT=unknown

RUN bash /src/deploy/stage-openclaw-source.sh /src /opt/live-source \
 && bash /src/deploy/verify-staged-source.sh /opt/live-source \
 && printf 'Generated by deploy/railway/Dockerfile\nSource commit: %s\nGenerated at: %s\n' \
      "$SOURCE_COMMIT" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > /opt/live-source/.OPENCLAW_GENERATED

# ---------------------------------------------------------------------------
# Stage 2: the gateway runtime image.
# ---------------------------------------------------------------------------
FROM node:26.12.1-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/joseph \
    OPENCLAW_HOME=/home/joseph/.openclaw \
    OPENCLAW_NO_AUTO_UPDATE=1 \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/joseph/.npm-global/bin

# Poppler renders CV pages and Tesseract recovers headings that embedded PDF
# fonts do not reliably expose to plain text extraction. rsync applies the baked
# source overlay onto the state volume at boot.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-pip \
      poppler-utils tesseract-ocr rsync \
      passwd sudo ca-certificates tini util-linux \
 && rm -rf /var/lib/apt/lists/*

# The node base image ships uid 1000 as `node`; use that uid for the gateway
# account so host-owned bind mounts retain the expected ownership.
RUN userdel -r node 2>/dev/null || true \
 && groupadd -g 1000 joseph \
 && useradd -m -u 1000 -g 1000 -s /bin/bash joseph

RUN npm install -g openclaw@2026.9.9 \
 && npm cache clean --force \
 && rm -rf /home/joseph/.npm

# Reuse the upstream pool's native-safe retirement rather than retaining its
# stateless model-discovery worker for the gateway's entire lifetime.
COPY deploy/railway/patch-worker-idle.py /usr/local/bin/patch-worker-idle.py
RUN python3 /usr/local/bin/patch-worker-idle.py /usr/local/lib/node_modules/openclaw

COPY deploy/railway/patch-history-idle.py /usr/local/bin/patch-history-idle.py
RUN python3 /usr/local/bin/patch-history-idle.py /usr/local/lib/node_modules/openclaw

# The reusable client is opt-in: its speedup retains SDK memory during send gaps.
# Keep the transient CLI default until campaign billing proves a win.
ENV GENAIE_CAMPAIGN_TRANSPORT=cli
ENV GENAIE_CATALOG_IDLE_RETIREMENT=0
ENV GENAIE_HISTORY_IDLE_RETIREMENT=0
ENV GENAIE_WHATSAPP_CACHE_CLEANUP=0
ENV GENAIE_OVERNIGHT_STANDBY=0
ENV GENAIE_WHATSAPP_HEALTH_AUDIT=1

# Bake the curated source overlay assembled in stage 1. The entrypoint syncs it
# onto the state volume on every boot (source of truth for workspace/ and the
# agent-workspace-*/*.md context files).
COPY --from=stage /opt/live-source /opt/live-source

COPY deploy/railway/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY deploy/railway/sync-public-prompt.py /usr/local/bin/sync-public-prompt.py
COPY deploy/railway/sync-reply-gates.py /usr/local/bin/sync-reply-gates.py
COPY deploy/railway/sync-runtime-plugins.py /usr/local/bin/sync-runtime-plugins.py
COPY deploy/railway/report-release-ready.py /usr/local/bin/report-release-ready.py
COPY deploy/railway/gateway-standby.py /usr/local/bin/gateway-standby.py
COPY deploy/railway/console-api.py /usr/local/bin/console-api.py
COPY deploy/railway/console_accounts.py /usr/local/bin/console_accounts.py
# console-read resolves the declared cron manifest from deploy/, which
# stage-openclaw-source.sh never stages, so bake a copy beside the helpers.
COPY deploy/promo-crons.json /usr/local/lib/genaie/promo-crons.json
RUN python3 -c 'from zoneinfo import ZoneInfo; ZoneInfo("Africa/Algiers")'
COPY deploy/railway/wait-gateway-lease.py /usr/local/bin/wait-gateway-lease.py
COPY deploy/railway/whatsapp-lid-loader.mjs deploy/railway/whatsapp-lid-recovery.mjs deploy/railway/whatsapp-cache-cleanup.mjs deploy/railway/whatsapp-health-audit.mjs /usr/local/lib/genaie/
COPY deploy/railway/whatsapp-group-discovery.mjs /usr/local/lib/genaie/
RUN chmod 0755 /usr/local/bin/entrypoint.sh /usr/local/bin/sync-public-prompt.py \
    /usr/local/bin/sync-reply-gates.py /usr/local/bin/sync-runtime-plugins.py \
    /usr/local/bin/wait-gateway-lease.py

EXPOSE 18789

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
