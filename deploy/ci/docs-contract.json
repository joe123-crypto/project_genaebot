{
  "version": 1,
  "rules": [
    {
      "name": "CI workflow",
      "paths": [
        ".github/workflows/**",
        ".github/actionlint.yaml"
      ],
      "requiredDocs": [
        "deploy/railway/README.md"
      ]
    },
    {
      "name": "production deployment",
      "paths": [
        "railway.json",
        "deploy/railway/**",
        "deploy/railway-release.py",
        "deploy/railway-cost-report.py",
        "deploy/stage-openclaw-source.sh",
        "deploy/verify-staged-source.sh",
        "deploy/stage-workspace.rsync",
        "deploy/gateway-exec.sh",
        "deploy/install-*.sh",
        "deploy/promo-crons.json",
        "deploy/reinstall-promo-crons.sh",
        "deploy/promo-cron-drift.py"
      ],
      "requiredDocs": [
        "README.md",
        "deploy/railway/README.md"
      ]
    },
    {
      "name": "public plugin configuration contract",
      "paths": [
        "workspace/plugins/*/openclaw.plugin.json"
      ],
      "requiredDocs": [
        "workspace/docs/public-services.md"
      ]
    },
    {
      "name": "public agent action surface",
      "paths": [
        "workspace/plugins/public-service-gate/index.js",
        "workspace/plugins/public-service-gate/services/*.js"
      ],
      "requiredDocs": [
        "workspace/docs/public-whatsapp-system-prompt.txt"
      ]
    },
    {
      "name": "CV maker public interface",
      "paths": [
        "workspace/plugins/public-service-gate/services/cv-maker.js",
        "workspace/skills/cv-maker/**"
      ],
      "requiredDocs": [
        "workspace/docs/cv-maker-onboarding.md"
      ]
    }
  ]
}
