# Default-deny repository policy.
# Track deterministic developer-owned source/config templates only.
*

# Repository metadata.
!.gitignore
!README.md
# Railway build config (root of the build context, read by the GitHub integration).
!railway.json
!.dockerignore
!.github/
!.github/actionlint.yaml
!.github/workflows/
!.github/workflows/*.yml

# New deterministic deployment/config surface.
!config/
!config/**
!deploy/
!deploy/**

# Agent identity/context docs.
!workspace/
!workspace/HEARTBEAT.md
!workspace/IDENTITY.md
!workspace/MEMORY.md
!workspace/SOUL.md
!workspace/USER.md

# Developer-controlled command/source files.
!workspace/bin/
!workspace/bin/**
!workspace/lib/
!workspace/lib/*.py
!workspace/lib/*.mjs
!workspace/*.py

# Plugins are source-controlled deployment artifacts.
!workspace/plugins/
!workspace/plugins/**

# Cron definitions are tracked, runtime state/logs are not.
!workspace/cron/
!workspace/data/
!workspace/data/*.json
!workspace/data/*.md
!workspace/cron/*/
!workspace/cron/*/*.py
!workspace/cron/*/*.sh

# CV promo campaign: editable target list + the ad image (developer-owned,
# deployed with the workspace).
!workspace/cron/cv-promo/targets.json
!workspace/cron/cv-promo/assets/
!workspace/cron/cv-promo/assets/*.png
!workspace/cron/cv-promo/assets/*.jpg

# Building-materials promo campaign: editable target list + the ad image
# (developer-owned, deployed with the workspace).
!workspace/cron/building-materials-promo/targets.json
!workspace/cron/building-materials-promo/assets/
!workspace/cron/building-materials-promo/assets/*.jpg

# Genaie-services promo campaign: editable target list + the ad image
# (developer-owned, deployed with the workspace).
!workspace/cron/genaie-promo/targets.json
!workspace/cron/genaie-promo/assets/
!workspace/cron/genaie-promo/assets/*.png

# Genaie lead-generation promo campaign: editable target list + the ad image
# (developer-owned, deployed with the workspace). Separate 17:00 cron from
# genaie-promo above.
!workspace/cron/genaie-leads-promo/targets.json
!workspace/cron/genaie-leads-promo/assets/
!workspace/cron/genaie-leads-promo/assets/*.png

# Fruit-trees promo campaign: editable target list + the ad image (developer-owned,
# deployed with the workspace). Daily 08:40 Africa/Harare cron.
!workspace/cron/fruit-trees-promo/targets.json
!workspace/cron/fruit-trees-promo/assets/
!workspace/cron/fruit-trees-promo/assets/*.jpg

# Single source of truth for the groups the bot advertises in: names, statuses,
# activity tiers and promo membership. The promo targets.json files are
# generated from it by workspace/bin/make-promo-targets (read by that generator,
# workspace/bin/list-groups and the promo crons' per-group caps).
!workspace/cron/membership.json

# Appliance-repairs promo campaign (APPLIANCE REPAIRS PL): editable target list +
# the ad image (developer-owned, deployed with the workspace). Daily 10:35
# Africa/Harare cron.
!workspace/cron/appliance-repairs-promo/targets.json
!workspace/cron/appliance-repairs-promo/assets/
!workspace/cron/appliance-repairs-promo/assets/*.jpg

# Borehole-drilling promo campaign: editable target list + the rotating ad images
# (developer-owned, deployed with the workspace). Daily 07:15 Africa/Harare cron.
!workspace/cron/borehole-drilling-promo/targets.json
!workspace/cron/borehole-drilling-promo/assets/
!workspace/cron/borehole-drilling-promo/assets/*.jpg

# Skylight-solar promo campaign: editable target list + the rotating ad posters
# (developer-owned, deployed with the workspace). Daily 13:21 Africa/Harare cron.
!workspace/cron/skylight-solar-promo/targets.json
!workspace/cron/skylight-solar-promo/assets/
!workspace/cron/skylight-solar-promo/assets/*.jpg

# Service docs and source helpers.
!workspace/docs/
!workspace/docs/**
# Standalone CV maker service.
!workspace/cv-maker/
!workspace/cv-maker/*.md
!workspace/cv-maker/*.py
!workspace/cv-maker/cvmaker/
!workspace/cv-maker/cvmaker/*.py


# Custom skills that are not purely reinstallable from package metadata.
!workspace/skills/
!workspace/skills/cv-maker/
!workspace/skills/cv-maker/SKILL.md
!workspace/skills/pdf-edit/
!workspace/skills/pdf-edit/SKILL.md
!workspace/skills/pdf-edit/pdf_edit.py
!workspace/skills.lock.json

# Never track generated/runtime/private content, even under allowed dirs.
.git/
workspace/.git/
**/.git/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.venv/
**/node_modules/
**/*.log
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.tmp
**/*.bak
**/*.bak-*
**/*.last-good
**/*.pre-update*
**/state.json
**/dispatch-runs/
**/users/
workspace/memory/
workspace/tmp/
workspace/jobs/
workspace/invites/
credentials/
identity/
devices/
agents/
memory/
logs/
state/
plugin-state/
flows/
tasks/
delivery-queue/
media/
npm/
browser/
cache/
voice-calls/
openclaw-runtime*
openclaw.json
openclaw.json*
.env
.env*
gateway.systemd.env
exec-approvals.json
update-check.json
gateway-supervisor-restart-handoff.json
workspace-attestations/
gitclaw/

# Genaie advertiser recruitment: generated targets and operator-supplied image.
!workspace/cron/genaie-advertisers-promo/targets.json
!workspace/cron/genaie-advertisers-promo/assets/
!workspace/cron/genaie-advertisers-promo/assets/*.jpg
